{{#unless isHtmx}}
  <a href="/roles" class="mb-4 inline-flex min-h-11 items-center gap-2 text-sm text-[#287a73]">
    {{> ui/icon name="arrow" class="h-4 w-4"}}قوالب الصلاحيات
  </a>
{{/unless}}
{{#> ui/dialog id="roles-delete-dialog" icon="trash" heading="حذف قالب الصلاحيات؟" description="راجع تفاصيل القالب قبل تأكيد الحذف." danger=true}}
  <div class="mb-5 rounded-xl border border-slate-200 bg-slate-50 p-4">
    <p class="text-xs font-bold text-slate-600">اسم القالب</p>
    <p class="mt-1 break-words text-base font-extrabold">{{role.name}}</p>
    {{#if role.description}}
      <p class="mt-3 whitespace-pre-line break-words text-sm leading-7 text-slate-600">{{role.description}}</p>
    {{/if}}
  </div>
  <p class="mb-5 text-sm leading-7 text-red-700">هذا الإجراء نهائي ولا يمكن التراجع عنه.</p>
  <form action="/roles/delete/{{role.id}}" method="post"
        hx-post="/roles/delete/{{role.id}}"
        hx-target="#roles-delete-dialog" hx-swap="outerHTML"
        hx-disabled-elt="find button[type='submit']" class="space-y-4">
    {{> ui/csrf}}
    {{> ui/form-error error=error}}
    {{> ui/form-error error=errors.name}}
    <div dir="rtl" class="flex flex-wrap justify-start gap-3">
      {{> ui/submit label="تأكيد الحذف" icon="trash" danger=true}}
      {{> ui/cancel label="إلغاء"}}
    </div>
  </form>
{{/ui/dialog}}
