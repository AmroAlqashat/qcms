<div id="roles-editor-content">
  {{#unless isHtmx}}
    <a href="/roles"
       class="mb-4 inline-flex min-h-11 items-center gap-2 text-sm text-[#287a73]">
      {{> ui/icon name="arrow" class="h-4 w-4"}}قوالب الصلاحيات
    </a>
  {{/unless}}
  <section id="roles-editor"
           aria-labelledby="roles-heading"
           class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
    <header class="flex items-center justify-between gap-4 border-b-2 border-[#c68c2b] bg-[#195954] p-5 text-white">
      <div>
        <h1 id="roles-heading" class="text-lg font-extrabold">
          {{#if role.id}}تعديل قالب «{{role.name}}»{{else}}قالب صلاحيات جديد{{/if}}
        </h1>
        <p class="mt-1 text-xs leading-6 text-[#c0e3dc]">اختر الإجراءات ثم حدّد نطاقها.</p>
      </div>
      <span class="rounded-xl bg-white/10 p-3 text-[#edbc5a]">{{> ui/icon name="folder"}}</span>
    </header>

    <form {{#if role.id}}id="role-editor-form"{{/if}}
          action="{{#if role.id}}/roles/edit/{{role.id}}{{else}}/roles/create{{/if}}"
          method="post"
          {{#if role.id}}hx-post="/roles/edit/{{role.id}}"{{else}}hx-post="/roles/create"{{/if}}
          hx-target="#roles-editor-content"
          hx-swap="outerHTML"
          class="space-y-5 p-4 sm:p-5"
          data-permission-editor>
      {{> ui/form-error error=error}}
      {{> ui/field id="role-name" name="name" label="اسم القالب" value=role.name required=true maxlength="100" error=errors.name}}
      <div class="min-w-0">
        <label for="role-description" class="mb-2 block text-sm font-semibold">وصف القالب</label>
        <textarea class="field block min-h-24 w-full rounded-lg border border-[#a8dfdc] bg-[#f0faf9] px-3 py-2.5 text-sm text-[#12383b]"
                  id="role-description"
                  name="description"
                  maxlength="400"
                  aria-describedby="role-description-error"
                  {{#if errors.description}}aria-invalid="true"{{/if}}>{{role.description}}</textarea>
        <p id="role-description-error"
           class="mt-1 text-xs text-red-700"
           {{#unless errors.description}}hidden{{/unless}}>{{errors.description}}</p>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 class="font-bold">الصلاحيات</h2>
          <p class="text-xs leading-6 text-slate-600">اختر الإجراءات وحدد نطاقها.</p>
        </div>
        <span class="rounded-full bg-[#f0faf9] px-3 py-1 text-xs font-bold text-[#287a73]"
              data-permission-total
              aria-live="polite">{{selectedPermissionCount}} محددة</span>
      </div>
      {{> ui/form-error error=errors.permissions}}
      <div class="grid items-start gap-4 xl:grid-cols-2">
        {{#each permissionColumns}}
          <div class="space-y-4">
            {{#each this}}
              {{#> permissions/folder prefix="ملف " category=category selectedCount=selectedCount}}
                {{#each resources}}
                  {{> permissions/resource}}
                {{/each}}
              {{/permissions/folder}}
            {{/each}}
          </div>
        {{/each}}
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap gap-2">
          {{#if role.id}}
            <button type="button"
                    class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-[#2b827a] px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#216c65]"
                    data-dialog-open="confirm-edit">{{> ui/icon name="check"}}تعديل القالب</button>
          {{else}}
            {{> ui/submit label="حفظ القالب" icon="check"}}
          {{/if}}
          <a href="/roles"
             class="inline-flex min-h-11 items-center rounded-xl border border-slate-200 px-5 py-2 text-sm font-bold text-slate-600">إلغاء</a>
        </div>
        {{#if role.id}}
          <a href="/roles/delete/{{role.id}}"
             class="inline-flex min-h-11 items-center rounded-xl border border-red-200 px-5 py-2 text-sm font-bold text-red-700 transition hover:bg-red-50">حذف القالب</a>
        {{/if}}
      </div>
    </form>

    <dialog id="confirm-edit"
            dir="rtl"
            aria-labelledby="confirm-edit-title"
            aria-describedby="confirm-edit-description"
            class="m-auto w-[92vw] max-w-md overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 text-[#12383b] shadow-2xl backdrop:bg-black/40">
      <div class="border-b border-slate-100 p-6">
        <h2 id="confirm-edit-title" class="text-lg font-extrabold">تأكيد تعديل القالب</h2>
        <p id="confirm-edit-description"
           class="mt-2 text-sm leading-7 text-slate-600">هل تريد حفظ التغييرات على قالب «{{role.name}}»؟</p>
        <div class="mt-4 rounded-xl bg-amber-50 p-4 text-sm leading-7 text-amber-900">
          <p>
            ستنطبق هذه التعديلات على هذا العدد من الموظفين:
            <strong>{{accountCount}}</strong>
          </p>
        </div>
      </div>
      <div class="flex flex-wrap justify-start gap-3 bg-slate-50 p-4">
        <button type="submit"
                form="role-editor-form"
                class="min-h-11 rounded-xl bg-[#2b827a] px-5 py-2 text-sm font-bold text-white hover:bg-[#216c65]">
          تأكيد الحفظ
        </button>
        <button type="button"
                data-dialog-close
                class="min-h-11 rounded-xl border border-slate-200 bg-white px-5 py-2 text-sm font-bold text-slate-600 hover:bg-slate-100">
          إلغاء
        </button>
      </div>
    </dialog>
  </section>
</div>
