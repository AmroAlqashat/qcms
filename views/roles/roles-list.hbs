<header class="mb-8 flex flex-wrap items-start justify-between gap-4">
  <div>
    <h1 class="text-3xl font-extrabold text-slate-900">قوالب الصلاحيات</h1>
    <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-600">
      القالب مجموعة صلاحيات جاهزة للإسناد، لا يحمل أي معنى غير ما يحتويه.
    </p>
  </div>
  {{#if permissions.canManageRoles }}
    <a href="/roles/create"
       class="inline-flex min-h-12 items-center gap-3 rounded-xl bg-[#2b827a] px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-[#246f68]">
      {{> ui/icon name="plus" class="h-5 w-5"}}
      قالب جديد
    </a>
  {{/if}}
</header>
<section aria-label="قوالب الصلاحيات" class="space-y-4">
  {{#each roles }}
    <a href="/roles/edit/{{id}}"
       class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-[#a8dfdc] hover:bg-[#fbfefd] hover:shadow-md sm:px-6">
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-[#eef9f7] text-[#287a73]">
        {{> ui/icon name="layers" class="h-7 w-7"}}
      </span>
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="truncate text-lg font-extrabold text-slate-900">{{name}}</h2>
          <span class="rounded-full border border-[#a8dfdc] bg-white px-3 py-1 text-xs font-bold text-[#287a73]">
            {{_count.staffGrants}} حساب
          </span>
        </div>
        {{#if description }}
          <p class="mt-2 line-clamp-2 text-sm leading-7 text-slate-600">{{description}}</p>
        {{else}}
          <p class="mt-2 text-sm leading-7 text-slate-500">لا يوجد وصف لهذا القالب.</p>
        {{/if}}
        <p class="mt-2 text-xs leading-6 text-slate-500">{{_count.rolePermissions}} صلاحية · أُنشئ في {{createdAt}}</p>
      </div>
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-slate-400 transition group-hover:bg-[#eef9f7] group-hover:text-[#287a73]">
        {{> ui/icon name="chevron" class="h-4 w-4"}}
      </span>
    </a>
  {{else}}
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center">
      <p class="text-sm font-bold text-slate-700">لا توجد قوالب بعد.</p>
      <p class="mt-2 text-sm text-slate-500">أنشئ أول قالب صلاحيات لاستخدامه مع الموظفين.</p>
    </div>
  {{/each}}
</section>
<p class="mt-6 text-center text-sm leading-7 text-slate-600">
  يمكن إسناد أكثر من قالب للحساب الواحد، وتُحتسب صلاحياته من مجموع المنح السارية.
</p>
