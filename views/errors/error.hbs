<!doctype html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{title}} · QCMS</title>
  <link rel="stylesheet" href="/css/source.css">
</head>
<body class="min-h-screen bg-[#f5f6f8] text-[#12383b] antialiased">
  <main class="flex min-h-screen items-center justify-center p-4">
    <section class="mx-auto max-w-2xl rounded-3xl border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-12">
      <p class="text-2xl font-extrabold text-[#287a73]">{{statusCode}}</p>
      <h1 class="mt-4 text-3xl font-extrabold">{{title}}</h1>
      <p class="mt-4 text-sm leading-7 text-slate-600" role="alert">{{message}}</p>
      <a href="/" class="mt-6 inline-flex rounded-xl bg-[#287a73] px-6 py-3 font-bold text-white">العودة للرئيسية</a>
    </section>
  </main>
</body>
</html>
