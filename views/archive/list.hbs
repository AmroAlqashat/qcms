<section class="mx-auto max-w-5xl space-y-5">
<header><h1 class="text-3xl font-extrabold">الأرشيف</h1><p class="mt-2 text-sm text-slate-600">السجلات المؤرشفة، مرتبة من الأحدث إلى الأقدم.</p></header>
<div class="flex flex-wrap gap-3">{{#if canArchiveActivities}}<a href="/archive/activities/new" hx-get="/archive/activities/new" hx-target="#modal-root" aria-haspopup="dialog" class="inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-[#216c65] hover:bg-[#f0faf9]">أرشفة نشاط</a>{{/if}}{{#if canArchiveTerms}}<a href="/archive/terms/new" hx-get="/archive/terms/new" hx-target="#modal-root" aria-haspopup="dialog" class="inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-[#216c65] hover:bg-[#f0faf9]">أرشفة فصل</a>{{/if}}{{#if canArchiveHalaqas}}<a href="/archive/halaqas/new" hx-get="/archive/halaqas/new" hx-target="#modal-root" aria-haspopup="dialog" class="inline-flex min-h-11 items-center rounded-xl border border-slate-200 bg-white px-4 text-sm font-bold text-[#216c65] hover:bg-[#f0faf9]">أرشفة حلقة</a>{{/if}}</div>
<form action="/archive" method="get" class="grid gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:grid-cols-[minmax(0,1fr)_auto_auto] sm:items-end">
<label class="grow">بحث<input type="search" name="q" value="{{search}}" class="mt-2 block min-h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3"></label>
<label>نوع السجل<select name="type" class="mt-2 block min-h-11 w-full rounded-lg border border-slate-200 bg-slate-50 px-3"><option value="">الكل</option>{{#if terms}}<option value="terms" {{#if (eq type "terms")}}selected{{/if}}>الفصول</option>{{/if}}{{#if halaqas}}<option value="halaqas" {{#if (eq type "halaqas")}}selected{{/if}}>الحلقات</option>{{/if}}{{#if activities}}<option value="activities" {{#if (eq type "activities")}}selected{{/if}}>الأنشطة</option>{{/if}}</select></label>{{> ui/submit label="بحث"}}
</form>
<ul aria-label="السجلات المؤرشفة" class="divide-y divide-slate-100 rounded-2xl border border-slate-200 bg-white px-5">{{#each rows}}<li class="flex flex-wrap items-center justify-between gap-3 py-4"><div><small class="font-semibold text-[#287a73]">{{label}}</small><h2 class="font-bold">{{#if (eq kind "activities")}}<a class="underline" href="/activities/{{id}}">{{name}}</a>{{else}}{{name}}{{/if}}</h2></div><span class="text-sm text-slate-600">{{date}}</span></li>{{else}}<li class="py-10 text-center text-slate-600">{{#if search}}لا توجد نتائج لهذا البحث. <a class="font-bold underline" href="/archive">مسح البحث</a>{{else}}لا توجد سجلات مؤرشفة ضمن هذا العرض.{{/if}}</li>{{/each}}</ul>
<nav class="flex gap-4">{{#if previous}}<a href="{{previous}}">السابق</a>{{/if}}{{#if next}}<a href="{{next}}">التالي</a>{{/if}}</nav></section>
