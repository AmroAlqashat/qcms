{{#> auth/card}}
  {{> auth/heading
    heading="تسجيل الدخول"
    description="أدخل بريدك الإلكتروني وكلمة المرور للوصول إلى حسابك."
  }}
  <form class='space-y-5' action='/auth/signin' method='post'>
    {{> ui/csrf}}
    {{#if successMessage}}
      <p class='rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800' role='status'>
        {{successMessage}}
      </p>
    {{/if}}
    {{> ui/form-error
      error=error
    }}
    {{> ui/field
      id="sign-in-email"
      name="email"
      label="البريد الإلكتروني"
      type="email"
      value=form.email
      required=true
      autocomplete="username"
      dir="ltr"
      maxlength="254"
      error=errors.email
    }}
    {{> ui/field
      id="sign-in-password"
      name="password"
      label="كلمة المرور"
      type="password"
      password=true
      required=true
      autocomplete="current-password"
      dir="ltr"
      error=errors.password
    }}
    {{> ui/submit
      label="تسجيل الدخول"
      full=true
    }}
    <p class='text-center text-sm'>
      <a class='font-semibold text-[#195954] underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#287a73]'
         href='/staff/forgot-my-password'>نسيت كلمة المرور؟</a>
    </p>
  </form>
{{/auth/card}}
