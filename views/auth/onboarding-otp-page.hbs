  <a href='/auth/signIn' class='mt-4 inline-flex min-h-11 items-center text-sm font-bold text-[#287a73] underline'>العودة إلى تسجيل الدخول</a>
{{/auth/card}}
{{> ui/otp-dialog dialogId="onboarding-otp-dialog" heading="تأكيد البريد الإلكتروني" description="أرسل رمزًا إلى بريدك المسجّل، ثم أدخله للمتابعة." action="/auth/onboarding/verify-otp" resendAction="/auth/onboarding/send-otp" submitLabel="تأكيد الرمز والمتابعة"}}
