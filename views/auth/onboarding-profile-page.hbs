{{#> auth/card}}
  {{> auth/heading
    heading="أكمل ملفك الشخصي"
    description="أكمل بياناتك المطلوبة، ثم تابع لإنشاء كلمة مرورك وتفعيل الحساب."
  }}
  {{> auth/steps-profile}}
  <form class='space-y-5' action='/auth/onboarding/complete-profile' method='post'>
    {{> ui/csrf}}
    {{> ui/form-error
      error=error
    }}
    {{> ui/field
      id="profile-full-name"
      name="fullName"
      label="الاسم الكامل"
      value=form.fullName
      required=true
      autocomplete="name"
      minlength="2"
      maxlength="100"
      error=errors.fullName
    }}
    <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
    <p class="text-sm font-semibold">المسمى الوظيفي</p>
    <p class="mt-1 text-sm">{{form.jobTitleLabel}}</p>
    <p class="mt-1 text-xs text-slate-600">يحدده مسؤول المركز. تواصل معه إذا احتجت إلى تصحيحه.</p>
  </div>
    {{> ui/field
      id="profile-birth"
      name="dateOfBirth"
      label="تاريخ الميلاد"
      type="date"
      value=form.dateOfBirth
      required=true
      autocomplete="bday"
      dir="ltr"
      error=errors.dateOfBirth
    }}
    {{> ui/field
      id="profile-national-id"
      name="nationalId"
      label="الرقم الوطني أو رقم الهوية"
      value=form.nationalId
      required=true
      dir="ltr"
      maxlength="30"
      error=errors.nationalId
    }}
    {{> ui/field
      id="profile-phone"
      name="phone"
      label="رقم الهاتف"
      type="tel"
      value=form.phone
      required=true
      autocomplete="tel"
      dir="ltr"
      maxlength="20"
      error=errors.phone
    }}
    {{> ui/submit
      label="المتابعة إلى كلمة المرور"
      icon="users"
      full=true
    }}
  </form>
{{/auth/card}}
