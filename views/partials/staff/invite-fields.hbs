{{> ui/field id="invite-email" name="email" label="البريد الإلكتروني" type="email" value=form.email dir="ltr" required=true autocomplete="off" maxlength="254" error=errors.email}}
{{> ui/field id="invite-name" name="fullName" label="الاسم الكامل" value=form.fullName required=true autocomplete="off" maxlength="120" error=errors.fullName}}
{{> ui/field id="invite-title" name="jobTitle" label="المسمى الوظيفي" value=form.jobTitle required=true autocomplete="off" maxlength="80" hint="وصف وظيفي فقط؛ لا يمنح أي صلاحيات." error=errors.jobTitle}}
