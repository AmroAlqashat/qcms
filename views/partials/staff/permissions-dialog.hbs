<dialog
  id='staff-permissions-dialog'
  class='m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-3xl overflow-y-auto rounded-3xl border border-slate-200 bg-white p-0 text-[#12383b] shadow-2xl backdrop:bg-black/40'
  dir='rtl'
  aria-labelledby='staff-permissions-dialog-title'
  aria-describedby='staff-permissions-dialog-description'
  data-auto-open
>
  <div class='p-5 sm:p-6'>
    <header class='mb-6 flex items-start gap-3'>
      <span class='flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#f0faf9] text-[#2b827a]'
      >
        {{> ui/icon
          name="sliders"
        }}
      </span>
      <div class='min-w-0 flex-1'>
        <h2 id='staff-permissions-dialog-title' class='text-lg font-extrabold leading-8'>
          تعديل صلاحيات الموظف
        </h2>
        <p id='staff-permissions-dialog-description' class='text-xs leading-6 text-slate-600'>
          أسند قوالب جاهزة أو أضف صلاحيات مباشرة لهذا الموظف.
        </p>
      </div>
      <button
        class='flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200'
        type='button'
        data-dialog-close
        aria-label='إغلاق النافذة'
      >
        {{> ui/icon
          name="close"
        }}
      </button>
    </header>

    {{!-- The shared permission script recognizes data-direct-grant-editor and
         builds permissionId/scope objects for this staff form only. --}}
    <form
      class='space-y-5'
      action='/staff/edit/permissions/{{ staffId }}'
      hx-post='/staff/edit/permissions/{{ staffId }}'
      hx-target='#staff-permissions-dialog'
      hx-swap='outerHTML'
      hx-disabled-elt="find button[type='submit']"
      method='post'
      data-permission-editor
      data-direct-grant-editor
    >
      {{> ui/csrf}}
      <section
        class='overflow-hidden rounded-2xl border border-slate-200'
        aria-labelledby='staff-role-assignments-title'
      >
        <header class='border-b border-slate-100 bg-slate-50 p-4'>
          <div class='flex flex-wrap items-center justify-between gap-2'>
            <div>
              <h3 id='staff-role-assignments-title' class='font-extrabold'>قوالب الصلاحيات</h3>
              <p class='mt-1 text-xs leading-6 text-slate-600'>
                فعّل القالب لإسناده أو ألغِ التحديد لإزالته من الموظف.
              </p>
            </div>
            <span class='rounded-full bg-white px-3 py-1 text-xs font-bold text-[#287a73]'>قوالب موجودة</span>
          </div>
        </header>
        <div class='grid gap-3 p-4 sm:grid-cols-2'>
          {{!-- Checked roleIds are the complete replacement selection. Unchecked
               checkboxes are omitted; the DTO turns a missing field into []. --}}
          {{#each roles}}
            <label
              class='flex min-h-20 cursor-pointer items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4 transition hover:border-[#a8dfdc]'
            >
              <input
                class='mt-1 h-5 w-5 accent-[#2b827a]'
                type='checkbox'
                name='roleIds'
                value='{{ id }}'
                {{#if selected}}
                  checked
                {{/if}}
              />
              <span class='min-w-0'>
                <span class='block text-sm font-extrabold'>{{ name }}</span>
                {{#if description}}
                  <span class='mt-1 block text-xs leading-6 text-slate-600'>
                    {{ description }}
                  </span>
                {{/if}}
              </span>
            </label>
          {{else}}
            <p class='text-sm text-slate-600'>لا توجد قوالب صلاحيات متاحة.</p>
          {{/each}}
        </div>
      </section>

      <section
        class='overflow-hidden rounded-2xl border border-slate-200'
        aria-labelledby='staff-direct-grants-title'
      >
        <header class='border-b border-slate-100 bg-slate-50 p-4'>
          <div class='flex flex-wrap items-center justify-between gap-2'>
            <div>
              <h3 id='staff-direct-grants-title' class='font-extrabold'>منح مباشرة</h3>
              <p class='mt-1 text-xs leading-6 text-slate-600'>
                امنح صلاحية واحدة أو أكثر دون إنشاء قالب جديد.
              </p>
            </div>
            <span class='rounded-full bg-[#f0faf9] px-3 py-1 text-xs font-bold text-[#287a73]' data-permission-total aria-live='polite'>{{ selectedPermissionCount }} محددة</span>
          </div>
        </header>
        <div class='grid items-start gap-4 p-4 xl:grid-cols-2'>
          {{#each permissionColumns}}
            <div class='space-y-4'>
              {{#each this}}
                {{#> permissions/folder category=category selectedCount=selectedCount open=true}}
                  {{#each resources}}
                    {{!-- Use permission IDs for native form values while keeping
                         the same checkbox/scope UI used by role editors. --}}
                    {{> permissions/resource directGrants=true}}
                  {{/each}}
                {{/permissions/folder}}
              {{/each}}
            </div>
          {{else}}
            <p class='text-sm text-slate-600'>لا توجد صلاحيات مباشرة متاحة للتعيين.</p>
          {{/each}}
        </div>
      </section>

      <div class='flex flex-wrap justify-start gap-2'>
        {{> ui/submit
          label="حفظ التغييرات"
          icon="check"
        }}
        <button
          class='inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold text-slate-600 hover:bg-slate-50'
          type='button'
          data-dialog-close
        >
          إلغاء
        </button>
      </div>
    </form>
  </div>
</dialog>
