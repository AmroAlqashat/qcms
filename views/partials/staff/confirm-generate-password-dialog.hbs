{{#> ui/dialog id="confirm-generate-password-dialog" icon="logout" heading="إنشاء كلمة مرور جديدة؟" description="راجع أثر هذا الإجراء قبل المتابعة." danger=true}}
  <p class="mb-4 font-bold">{{staff.fullName}}</p>
  <ul class="mb-5 list-inside list-disc space-y-2 text-sm leading-7 text-slate-600">
    <li>ستتوقف كلمة المرور الحالية عن العمل فور التأكيد.</li>
    <li>ستصبح جلسات الموظف الحالية غير صالحة، وسيُطلب منه تسجيل الدخول عند طلبه التالي.</li>
    <li>ستظهر لك كلمة المرور الجديدة لتنسخها وتسلّمها للموظف بطريقة آمنة.</li>
  </ul>
  <form action="/staff/generate-new-password/{{staff.id}}" method="post"
    hx-post="/staff/generate-new-password/{{staff.id}}" hx-target="#modal-root" hx-swap="innerHTML"
    hx-disabled-elt="find button[type='submit']">
    {{> ui/csrf}}
    <div class="flex flex-wrap justify-start gap-2">
      {{> ui/cancel label="إلغاء"}}
      {{> ui/submit label="تأكيد إنشاء كلمة مرور" danger=true}}
    </div>
  </form>
{{/ui/dialog}}
