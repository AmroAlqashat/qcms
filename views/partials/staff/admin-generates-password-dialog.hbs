{{#> ui/dialog id="generate-password-dialog" icon="circle" heading="إنشاء كلمة مرور للموظف" description="" danger=true sensitive=true}}
  <div class='rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4'>
    <label class='mb-2 block text-xs text-slate-600' for='temporary-password'>كلمة المرور المؤقتة</label>
    <div class='flex items-center gap-2'>
      <input
        id='temporary-password'
        class='min-w-0 flex-1 bg-transparent text-right font-mono text-base font-bold text-[#92600c]'
        readonly
        dir='ltr'
        value='{{ temporaryPassword }}'
        autocomplete='off'
        {{#unless temporaryPassword}}
          placeholder="غير متاحة؛ أعد إصدار الدعوة"
        {{/unless}}
      />
      <button
        class='flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-[#287a73] hover:bg-white'
        type='button'
        data-copy='temporary-password'
        aria-label='نسخ كلمة المرور المؤقتة'
        {{#unless temporaryPassword}}
          disabled
        {{/unless}}
      >
        {{> ui/icon
          name="copy"
        }}
      </button>
    </div>
    <p class='text-xs text-[#287a73]' data-copy-feedback role='status'></p>
  </div>
{{/ui/dialog}}
