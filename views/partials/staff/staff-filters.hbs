<form action="/staff"
      method="get"
      hx-get="/staff"
      hx-target="#staff-results"
      hx-select="#staff-results"
      hx-swap="outerHTML"
      class="mb-4 rounded-2xl border border-slate-200 bg-white p-3">
  <label for="staff-search" class="sr-only">بحث عن موظف</label>
  <div class="relative">
    <span class="pointer-events-none absolute right-3 top-3.5 text-slate-400">{{> ui/icon name="search" class="h-4 w-4"}}</span><input id="staff-search"
       name="searchField"
       value="{{filters.searchField}}"
       type="search"
       placeholder="بحث بالاسم أو المسمى أو الحلقة أو النشاط…"
       class="min-h-11 w-full rounded-lg border border-slate-200 py-3 pr-10 pl-3 text-sm"
       hx-get="/staff"
       hx-trigger="input changed delay:350ms, search"
       hx-include="closest form"
       hx-target="#staff-results"
       hx-select="#staff-results"
       hx-swap="outerHTML">
  </div>
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <label for="status" class="sr-only">حالة الحساب</label><select id="status"
        name="status"
        class="min-h-11 rounded-full border border-[#a8dfdc] bg-white px-3 text-sm"
        data-auto-submit>
      <option value="" {{#unless filters.status}}selected{{/unless}}>الكل</option>
      <option value="ACTIVE" {{#if (eq filters.status 'ACTIVE') }}selected{{/if}}>نشط</option>
      <option value="INACTIVE"
              {{#if (eq filters.status 'INACTIVE') }}selected{{/if}}>موقوف</option>
      <option value="DELETED" {{#if (eq filters.status 'DELETED') }}selected{{/if}}>محذوف</option>
    </select>
    <label for="filter-class" class="sr-only">الحلقة</label><select id="filter-halaqa"
        name="halaqa"
        class="min-h-11 max-w-full rounded-full border border-slate-200 bg-white px-3 text-sm"
        data-auto-submit>
      <option value="">كل الحلقات</option>{{#each filterOptions.halaqa }}
      <option value="{{id}}" {{#if selected }}selected{{/if}}>{{name}}</option>
    {{/each}}
  </select>
  <label for="filter-template" class="sr-only">قالب الصلاحيات</label><select id="filter-template"
        name="role"
        class="min-h-11 max-w-full rounded-full border border-slate-200 bg-white px-3 text-sm"
        data-auto-submit>
    <option value="" {{#unless filters.role}}selected{{/unless}}>كل القوالب</option>{{#each filterOptions.templates }}
    <option value="{{id}}" {{#if selected }}selected{{/if}}>{{name}}</option>
  {{/each}}
</select>
<button type="submit"
        class="mr-auto min-h-11 rounded-lg px-4 text-sm font-bold text-[#287a73] hover:bg-[#f0faf9]">تطبيق</button>
</div>
</form>
