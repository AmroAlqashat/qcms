{{#> ui/dialog id="credentials-dialog" icon="check-shield" heading="أُنشئ حساب معلّق" description="سلّم هذه البيانات للموظف ليكمل التفعيل" sensitive=true}}
  <div class='space-y-3' data-sensitive-credentials>
    <div class='rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4'>
      <p class='mb-1 text-xs text-slate-600'>البريد الإلكتروني</p>
      <p class='break-anywhere text-right text-sm font-bold' dir='ltr'>{{ staff.email }}</p>
    </div>
    <div class='rounded-xl border border-dashed border-slate-200 bg-slate-50 p-4'>
      <label class='mb-2 block text-xs text-slate-600' for='temporary-password'>كلمة المرور المؤقتة</label>
      <div class='flex items-center gap-2'>
        <input
          id='temporary-password'
          class='min-w-0 flex-1 bg-transparent text-right font-mono text-base font-bold text-[#92600c]'
          readonly
          dir='ltr'
          value='{{ temporaryPassword }}'
          autocomplete='off'
          {{#unless temporaryPassword}}
            placeholder="غير متاحة؛ أعد إصدار الدعوة"
          {{/unless}}
        />
        <button
          class='flex h-11 w-11 shrink-0 items-center justify-center rounded-lg text-[#287a73] hover:bg-white'
          type='button'
          data-copy='temporary-password'
          aria-label='نسخ كلمة المرور المؤقتة'
          {{#unless temporaryPassword}}
            disabled
          {{/unless}}
        >
          {{> ui/icon
            name="copy"
          }}
        </button>
      </div>
      <p class='text-xs text-[#287a73]' data-copy-feedback role='status'></p>
    </div>
    {{> ui/alert
      warning=true
      message="تظهر كلمة المرور مرة واحدة هنا. انسخها قبل الإغلاق؛ إن فقدتها فأصدر كلمة مرور مؤقتة جديدة. تتوقف القديمة عند استبدالها."
    }}
    <div class='flex flex-wrap justify-start gap-2'>
      {{#if permissions.canCancelInvitation}}
        <form
          action='/staff/invitations/{{ staff.id }}/cancel'
          method='post'
          hx-post='/staff/invitations/{{ staff.id }}/cancel'
          hx-target='#credentials-dialog'
          hx-swap='outerHTML'
          hx-disabled-elt="find button[type='submit']"
        >
          {{> ui/csrf}}
          <button
            class='min-h-11 rounded-xl border border-red-200 px-4 py-2 text-sm font-bold text-red-700'
            type='submit'
          >
            إلغاء الدعوة
          </button>
        </form>
      {{/if}}
      <button
        class='min-h-11 rounded-xl bg-[#2b827a] px-5 py-2 text-sm font-bold text-white'
        type='button'
        data-dialog-close
      >
        تم
      </button>
    </div>
  </div>
{{/ui/dialog}}
