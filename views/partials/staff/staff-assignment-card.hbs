<div class="min-w-0 rounded-2xl border border-slate-200 bg-slate-50 p-5">
  <div class="mb-4 flex items-center justify-between gap-3">
    <span class="inline-flex rounded-xl bg-[#e3f2ef] p-2.5 text-[#287a73]" aria-hidden="true">
      {{> ui/icon name=icon}}
    </span>
    <span class="rounded-lg border border-slate-200 bg-white px-3 py-1 text-sm font-extrabold tabular-nums text-[#195954]" aria-label="عدد {{heading}}">
      {{#if items.length}}{{items.length}}{{else}}0{{/if}}
    </span>
  </div>
  <h3 class="text-sm font-bold">{{heading}}</h3>
  {{#if items.length}}
    <ul class="mt-3 flex flex-wrap gap-2 text-sm leading-6">
      {{#each items}}
        <li class="max-w-full break-words rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-slate-700">{{name}}</li>
      {{/each}}
    </ul>
  {{else}}
    <p class="mt-3 text-sm leading-7 text-slate-500">{{#if emptyLabel}}{{emptyLabel}}{{else}}لا توجد تعيينات{{/if}}</p>
  {{/if}}
</div>
