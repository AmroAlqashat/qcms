<dialog id="{{id}}" data-auto-open aria-labelledby="{{id}}-title" {{#if sensitive}}hx-history="false" {{/if}}
  class="w-[calc(100%-2rem)] max-w-[520px] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-3xl bg-white shadow-2xl">
  <div class="p-5 sm:p-6">
    <header class="mb-5 flex items-start gap-3">
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl {{#if danger}}bg-red-50 text-red-700{{else}}bg-[#f0faf9] text-[#2b827a]{{/if}}">{{> ui/icon name=icon}}</span>
      <div class="min-w-0 flex-1">
        <h2 id="{{id}}-title" class="text-lg font-extrabold leading-8">{{heading}}</h2>{{#if description}}
          <p class="text-xs leading-6 text-slate-600">{{description}}</p>
        {{/if}}
      </div>
      <button type="button" data-dialog-close
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-600 hover:bg-slate-200"
        aria-label="إغلاق النافذة">{{> ui/icon name="close"}}</button>
    </header>
    {{> @partial-block}}
  </div>
</dialog>
