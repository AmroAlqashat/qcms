<div class="min-w-0">
  <label for="{{id}}" class="mb-2 block text-sm font-semibold">{{label}}{{#if optional}} <span
        class="text-xs font-normal text-slate-600">(اختياري)</span>{{/if}}</label>
  <div class="relative">
    <input
      class="field block min-h-11 w-full rounded-lg border border-[#a8dfdc] bg-[#f0faf9] px-3 py-2.5 text-sm text-[#12383b] {{#if password}}pr-12{{/if}}"
      id="{{id}}" name="{{name}}" type="{{#if type}}{{type}}{{else}}text{{/if}}" {{#unless password}}value="{{value}}"
      {{/unless}} {{#if required}}required{{/if}} {{#if autocomplete}}autocomplete="{{autocomplete}}" {{/if}}
      {{#if dir}}dir="{{dir}}" {{/if}} {{#if maxlength}}maxlength="{{maxlength}}" {{/if}}
      {{#if minlength}}minlength="{{minlength}}" {{/if}} {{#if pattern}}pattern="{{pattern}}" {{/if}}
      {{#if inputmode}}inputmode="{{inputmode}}" {{/if}} {{#if max}}max="{{max}}" {{/if}}
      {{#if error}}aria-invalid="true" {{/if}} {{#if hint}}aria-describedby="{{id}}-hint {{id}}-error"
      {{else}}aria-describedby="{{id}}-error" {{/if}}>
    {{#if password}}<button type="button"
        class="absolute inset-y-0 right-0 flex w-11 items-center justify-center text-[#2b827a]"
        data-password-toggle="{{id}}" aria-controls="{{id}}" aria-label="إظهار كلمة المرور"
        aria-pressed="false">{{> ui/icon name="eye"}}</button>{{/if}}
  </div>
  {{#if hint}}
    <p id="{{id}}-hint" class="mt-1 text-xs leading-6 text-slate-600">{{hint}}</p>
  {{/if}}
  <p id="{{id}}-error" class="mt-1 text-xs text-red-700" {{#unless error}}hidden{{/unless}}>{{error}}</p>
</div>
