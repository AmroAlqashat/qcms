<div class="min-w-0">
  <label for="{{id}}" class="mb-2 block text-sm font-semibold">{{label}}</label>
  <input
    class="field block min-h-11 w-full rounded-lg border border-[#a8dfdc] bg-[#f0faf9] px-3 py-2.5 text-sm text-[#12383b]"
    id="{{id}}" name="{{name}}" type="{{#if type}}{{type}}{{else}}text{{/if}}"
    value="{{value}}" {{#if required}}required{{/if}}
    {{#if maxlength}}maxlength="{{maxlength}}"{{/if}}
    {{#if dir}}dir="{{dir}}"{{/if}}
    {{#if error}}aria-invalid="true"{{/if}}>
  <p id="{{id}}-error" class="mt-1 text-xs text-red-700" {{#unless error}}hidden{{/unless}}>{{error}}</p>
</div>
