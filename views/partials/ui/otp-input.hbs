<div>
  <label class='mb-2 block text-sm font-bold' for='{{id}}-code'>رمز التحقق</label>
  <input id='{{id}}-code' name='otp' type='text' inputmode='numeric'
    autocomplete='one-time-code' pattern='[0-9]{6}' minlength='6' maxlength='6' required dir='ltr'
    class='otp-input block min-h-14 w-full rounded-xl border border-[#a8dfdc] bg-[#f0faf9] px-3 py-3 text-center text-2xl font-extrabold'
    aria-describedby='{{id}}-hint{{#if error}} {{id}}-error{{/if}}'
    {{#if error}}aria-invalid='true'{{/if}}>
  <p id='{{id}}-hint' class='mt-2 text-xs leading-6 text-slate-600'>يمكنك لصق الرمز كاملًا. صلاحيته خمس دقائق وبحد أقصى خمس محاولات.</p>
  {{#if error}}<p id='{{id}}-error' class='mt-1 text-xs text-red-700' role='alert'>{{error}}</p>{{/if}}
</div>
