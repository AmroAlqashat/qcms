{{#> ui/dialog id="create-term-dialog" icon="calendar" heading="إنشاء فصل جديد" description="اختر نوع الفصل وأدخل بياناته."}}
  <form action="/terms/create" method="post" hx-post="/terms/create" hx-target="#modal-root" hx-swap="innerHTML"
    hx-disabled-elt="find button[type='submit']" data-term-form class="space-y-5">
    {{> ui/csrf}}
    {{> ui/form-error error=error}}
    <fieldset>
      <legend class="mb-3 text-sm font-bold">نوع الفصل</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 has-[:checked]:border-[#287a73] has-[:checked]:bg-[#f0faf9]">
          <input type="radio" name="type" value="STANDARD" required {{#if (eq type "STANDARD")}}checked{{/if}} class="mt-1 h-4 w-4 accent-[#287a73]" aria-describedby="term-type-error">
          <span><span class="block text-sm font-bold">فصل عادي</span><span class="mt-1 block text-xs leading-6 text-slate-600">له تاريخ بداية ونهاية.</span></span>
        </label>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 has-[:checked]:border-[#287a73] has-[:checked]:bg-[#f0faf9]">
          <input type="radio" name="type" value="CONTINUOUS" required {{#if (eq type "CONTINUOUS")}}checked{{/if}} class="mt-1 h-4 w-4 accent-[#287a73]" aria-describedby="term-type-error">
          <span><span class="block text-sm font-bold">فصل مستمر</span><span class="mt-1 block text-xs leading-6 text-slate-600">دون تاريخ بداية أو نهاية.</span></span>
        </label>
      </div>
      <p id="term-type-error" class="mt-2 text-xs text-red-700">{{errors.type}}</p>
    </fieldset>
    {{> ui/field id="new-term-id" name="termId" label="معرّف الفصل" value=termId required=true minlength="5" maxlength="5" pattern="[1-9][0-9]{3}[1-9]" inputmode="numeric" dir="ltr" error=errors.termId hint="اقتراح قابل للتعديل: السنة من أربعة أرقام، ثم رقم الفصل من 1 إلى 9. يجب أن يكون المعرّف فريدًا."}}
    <fieldset data-term-dates class="grid gap-4 sm:grid-cols-2" {{#if (eq type "CONTINUOUS")}}hidden disabled{{/if}}>
      <legend class="sr-only">الفترة الزمنية</legend>
      {{> ui/field id="term-start" name="startDate" label="تاريخ البداية" type="date" value=startDate required=true error=errors.startDate dir="ltr"}}
      {{> ui/field id="term-end" name="endDate" label="تاريخ النهاية" type="date" value=endDate required=true error=errors.endDate dir="ltr"}}
    </fieldset>
    <p class="rounded-xl bg-slate-50 p-3 text-xs leading-6 text-slate-600">لا تتم أرشفة الفصل تلقائيًا. يبقى نشطًا حتى تتم أرشفته يدويًا.</p>
    <div class="flex flex-wrap justify-start gap-2 border-t border-slate-100 pt-4">
      {{> ui/submit label="إنشاء الفصل"}}
      {{> ui/cancel label="إلغاء"}}
    </div>
  </form>
{{/ui/dialog}}
