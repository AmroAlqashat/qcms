<section id="terms-results" aria-label="نتائج البحث عن الفصول">
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-1">
    <h2 class="text-sm font-bold">الفصول النشطة</h2>
    <p class="text-xs text-slate-500" role="status" aria-live="polite">{{terms.length}} فصل{{#if filters.termId}} · نتائج «<bdi>{{filters.termId}}</bdi>»{{/if}}</p>
  </div>
  {{#if terms.length}}
    <div class="grid gap-3 sm:hidden">
      {{#each terms}}
        <a href="/terms/{{id}}" class="block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm focus-visible:outline-2 focus-visible:outline-[#287a73]">
          <div class="flex items-start justify-between gap-3"><div><h3 class="text-lg font-extrabold">الفصل <bdi>{{termId}}</bdi></h3><p class="mt-1 text-xs text-slate-500">{{typeLabel}}</p></div><span class="rounded-full bg-[#f0faf9] px-3 py-1 text-xs font-bold text-[#287a73]">نشط</span></div>
          <p class="mt-4 text-sm leading-7 text-slate-600">{{#if isContinuous}}مستمر دون فترة زمنية محددة{{else}}من {{startDateLabel}}<br>إلى {{endDateLabel}}{{/if}}</p>
          <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3 text-sm"><span class="text-slate-500">{{_count.halaqas}} حلقة</span><span class="inline-flex items-center gap-1 font-bold text-[#287a73]">عرض التفاصيل {{> ui/icon name="chevron" class="h-4 w-4"}}</span></div>
        </a>
      {{/each}}
    </div>
    <div class="hidden overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm sm:block">
      <table class="w-full text-right text-sm">
        <caption class="sr-only">الفصول النشطة</caption>
        <thead class="border-b border-slate-100 bg-slate-50 text-slate-500"><tr>
          <th scope="col" class="px-5 py-4">الفصل</th><th scope="col" class="px-5 py-4">الفترة</th><th scope="col" class="px-5 py-4">الحلقات</th><th scope="col" class="px-5 py-4">الحالة</th><th scope="col" class="px-5 py-4"><span class="sr-only">فتح الفصل</span></th>
        </tr></thead>
        <tbody class="divide-y divide-slate-100">{{#each terms}}
          <tr class="hover:bg-slate-50">
            <th scope="row" class="whitespace-nowrap px-5 py-5"><a href="/terms/{{id}}" class="font-extrabold text-[#195954] underline-offset-4 hover:underline">الفصل <bdi>{{termId}}</bdi></a><p class="mt-1 text-xs font-normal text-slate-500">{{typeLabel}}</p></th>
            <td class="px-5 py-5 text-slate-600">{{#if isContinuous}}مستمر دون فترة زمنية محددة{{else}}<span class="block whitespace-nowrap">من {{startDateLabel}}</span><span class="block whitespace-nowrap">إلى {{endDateLabel}}</span>{{/if}}</td>
            <td class="px-5 py-5 tabular-nums">{{_count.halaqas}}</td>
            <td class="px-5 py-5"><span class="rounded-full bg-[#f0faf9] px-3 py-1 text-xs font-bold text-[#287a73]">نشط</span></td>
            <td class="px-5 py-5"><a href="/terms/{{id}}" aria-label="فتح الفصل {{termId}}" class="inline-flex min-h-11 items-center gap-1 rounded-lg px-3 font-bold text-[#287a73] hover:bg-[#f0faf9]">فتح {{> ui/icon name="chevron" class="h-4 w-4"}}</a></td>
          </tr>
        {{/each}}</tbody>
      </table>
    </div>
  {{else}}
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-12 text-center">
      <span class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#f0faf9] text-[#287a73]">{{> ui/icon name="search"}}</span>
      <h3 class="font-bold">{{#if filters.termId}}لا توجد فصول تطابق بحثك{{else}}لا توجد فصول نشطة بعد{{/if}}</h3>
      <p class="mt-2 text-sm leading-7 text-slate-500">{{#if filters.termId}}جرّب سنة أو معرّفًا آخر، أو امسح البحث لعرض جميع الفصول.{{else}}{{#if permissions.canCreateTerm}}ابدأ بإنشاء فصل جديد لتنظيم الحلقات.{{else}}ستظهر الفصول هنا عند إنشائها.{{/if}}{{/if}}</p>
    </div>
  {{/if}}
</section>
