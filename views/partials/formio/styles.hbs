{{!--
  Form.io styles. Include only on pages that show Form.io, through the
  layout's styles slot:

    {{#section "styles"}}{{> formio/styles builder=true}}{{/section}}

  builder=true  form builder pages (admin)
  (omitted)     form renderer pages (e.g. public apply page)

  Wrap the Form.io container in <div class="formio-scope">: Bootstrap in
  formio-scope.css applies only inside it. Files are generated by
  `npm run css:formio` (scripts/build-formio-css.mjs).
--}}
<link rel="stylesheet" href="/css/formio-scope.css">
{{#if builder}}
  <link rel="stylesheet" href="/vendor/formio/formio.full.min.css">
{{else}}
  <link rel="stylesheet" href="/vendor/formio/formio.form.min.css">
  <link rel="stylesheet" href="/vendor/formio/formio-icons.min.css">
{{/if}}
