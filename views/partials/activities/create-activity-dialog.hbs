{{#> ui/dialog id="create-activity-dialog" wide=true icon="calendar" heading=sectionTitle description="أدخل بيانات النشاط وحدد ما إذا كان تابعًا للمركز أو لحلقة بعينها."}}
  <form action="{{formAction}}" method="post" hx-post="{{formAction}}" hx-target="#modal-root" hx-swap="innerHTML"
    hx-disabled-elt="find button[type='submit']" data-activity-form class="space-y-5">
    {{> ui/csrf}}
    {{> ui/form-error error=error}}
    {{> ui/field id="activity-name" name="name" label="اسم النشاط" value=name required=true error=errors.name}}

    <fieldset>
      <legend class="mb-3 text-sm font-bold">نطاق النشاط</legend>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 has-[:checked]:border-[#287a73] has-[:checked]:bg-[#f0faf9]">
          <input type="radio" name="level" value="CENTER_WIDE" required {{#if (eq level "CENTER_WIDE")}}checked{{/if}} class="mt-1 h-4 w-4 accent-[#287a73]">
          <span><span class="block text-sm font-bold">نشاط على مستوى المركز</span><span class="mt-1 block text-xs leading-6 text-slate-600">لا يرتبط بحلقة محددة.</span></span>
        </label>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-slate-200 bg-white p-4 has-[:checked]:border-[#287a73] has-[:checked]:bg-[#f0faf9]">
          <input type="radio" name="level" value="HALAQA_SPECIFIC" required {{#if (eq level "HALAQA_SPECIFIC")}}checked{{/if}} {{#unless halaqas.length}}disabled{{/unless}} class="mt-1 h-4 w-4 accent-[#287a73]">
          <span><span class="block text-sm font-bold">نشاط خاص بحلقة</span><span class="mt-1 block text-xs leading-6 text-slate-600">اختر الحلقة التي سيقام النشاط لها.</span></span>
        </label>
      </div>
      {{#if errors.level}}<p class="mt-2 text-xs text-red-700">{{errors.level}}</p>{{/if}}
    </fieldset>

    <fieldset data-activity-halaqa {{#if (eq level "CENTER_WIDE")}}hidden disabled{{/if}}>
      <label for="activity-halaqa" class="mb-2 block text-sm font-semibold">الحلقة</label>
      {{#if halaqas.length}}
        <select id="activity-halaqa" name="halaqaId" data-activity-halaqa-select {{#if (eq level "HALAQA_SPECIFIC")}}required{{else}}disabled{{/if}}
          class="block min-h-11 w-full rounded-lg border border-[#a8dfdc] bg-[#f0faf9] px-3 py-2.5 text-sm text-[#12383b] focus:border-[#287a73] focus:ring-2 focus:ring-[#a8dfdc]"
          {{#if errors.halaqaId}}aria-invalid="true" aria-describedby="activity-halaqa-error"{{/if}}>
          <option value="">اختر الحلقة</option>
          {{#each halaqas}}<option value="{{id}}" {{#if (eq ../halaqaId id)}}selected{{/if}}>{{name}} · الفصل {{term.termId}}</option>{{/each}}
        </select>
      {{else}}
        <p class="rounded-xl border border-amber-200 bg-amber-50 p-3 text-sm leading-6 text-amber-800">لا توجد حلقات نشطة للاختيار. أنشئ حلقة ضمن فصل نشط أولًا.</p>
      {{/if}}
      <p id="activity-halaqa-error" class="mt-1 text-xs text-red-700" {{#unless errors.halaqaId}}hidden{{/unless}}>{{errors.halaqaId}}</p>
    </fieldset>

    {{> ui/field id="activity-location" name="location" label="موقع إقامة النشاط" value=location required=true maxlength="200" error=errors.location hint="اكتب اسم الموقع أو عنوانه، بحد أقصى 200 حرف."}}
    <div class="grid gap-4 sm:grid-cols-2">
    {{> ui/field id="activity-date" name="date" label="تاريخ النشاط" type="date" value=date required=true error=errors.date dir="ltr"}}
    {{> ui/field id="activity-time" name="time" label="وقت النشاط (بتوقيت عمّان)" type="time" value=time required=true error=errors.time}}
    </div>
    <fieldset class="space-y-3 rounded-xl border border-slate-200 p-4"><legend class="px-2 text-sm font-bold">إعدادات التقديم</legend>
    <label class="block text-sm font-bold">نموذج التسجيل
      {{!-- A disabled <select> isn't sent, so the hidden input keeps formId. --}}
      {{#if isFormLocked}}<input type="hidden" name="formId" value="{{formId}}">{{/if}}
      <select {{#if isFormLocked}}disabled aria-describedby="form-locked-note"{{else}}name="formId" required{{/if}} class="field mt-2 w-full rounded-lg border p-3 disabled:cursor-not-allowed disabled:bg-slate-100 disabled:text-slate-500">
        <option value="">اختر نموذج التسجيل</option>
        {{#each forms}}<option value="{{id}}" {{#if (eq id ../formId)}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
    </label>
    {{#if isFormLocked}}
      <p id="form-locked-note" class="flex items-start gap-1.5 text-xs leading-6 text-[#92600c]">
        {{> ui/icon name="lock" class="mt-1 h-3.5 w-3.5 shrink-0"}}لا يمكن تغيير النموذج لأن النشاط لديه مشاركون.
      </p>
    {{/if}}
    {{#unless forms}}<p class="text-sm">لا توجد نماذج تسجيل متاحة.</p>{{/unless}}
    {{#if errors.formId}}<p role="alert" class="text-xs text-red-700">{{errors.formId}}</p>{{/if}}
    <label class="flex min-h-12 cursor-pointer items-center justify-between gap-3 rounded-xl border border-slate-200 px-4 py-2">
      <span id="activity-registration-label" class="text-sm font-bold">تفعيل نموذج التسجيل</span>
      <span class="relative inline-flex items-center gap-2">
        <input class="peer sr-only" type="checkbox" role="switch" aria-labelledby="activity-registration-label" name="isFormEnabled" value="true" {{#if isFormEnabled}}checked{{/if}}>
        <span aria-hidden="true" class="text-sm text-slate-600 peer-checked:hidden">غير مفعّل</span>
        <span aria-hidden="true" class="hidden text-sm font-bold text-[#287a73] peer-checked:inline">مفعّل</span>
        <span aria-hidden="true" class="relative h-6 w-11 rounded-full bg-slate-400 peer-checked:bg-[#287a73] peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 after:absolute after:top-1 after:right-1 after:h-4 after:w-4 after:rounded-full after:bg-white after:transition-transform peer-checked:after:-translate-x-5"></span>
      </span>
    </label>
    {{> ui/field id="activity-close" name="closeDate" label="إغلاق التقديم (بتوقيت عمّان)" optional=true type="datetime-local" value=closeDate error=errors.closeDate}}
    </fieldset>

    <div class="flex flex-wrap justify-start gap-2 border-t border-slate-100 pt-4">
      {{> ui/submit label="حفظ النشاط" icon="check"}}
      {{> ui/cancel label="إلغاء"}}
    </div>
  </form>
{{/ui/dialog}}
