<section aria-labelledby="activity-title" class="mx-auto max-w-5xl space-y-5">
  <a class="inline-flex min-h-11 items-center gap-2 rounded-lg px-3 text-sm font-bold text-[#287a73] hover:bg-[#f0faf9] focus-visible:outline-2" href="{{#if archived}}/archive{{else}}/activities{{/if}}">
    {{> ui/icon name="arrow" class="h-4 w-4"}}
    {{#if archived}}العودة إلى الأرشيف{{else}}العودة إلى الأنشطة{{/if}}
  </a>
  <header class="flex flex-wrap items-center justify-between gap-5 rounded-2xl border border-slate-200 bg-white p-6">
    <div class="min-w-0"><p class="text-sm font-bold text-[#287a73]">{{activity.levelLabel}}{{#if archived}} · مؤرشف{{/if}}</p>
      <h1 id="activity-title" class="my-2 break-words text-2xl font-extrabold">{{activity.name}}</h1>
      <dl class="mt-4 flex flex-wrap gap-x-8 gap-y-3 text-sm">
        <div><dt class="text-xs text-slate-500">الموعد · بتوقيت عمّان</dt><dd class="mt-1 font-semibold">{{activity.dateLabel}}</dd></div>
        <div><dt class="text-xs text-slate-500">المكان</dt><dd class="mt-1 break-words font-semibold">{{activity.location}}</dd></div>
        {{#if activity.halaqa}}<div><dt class="text-xs text-slate-500">الحلقة</dt><dd class="mt-1 font-semibold">{{activity.halaqa.name}}</dd></div>{{/if}}
      </dl>
      <p class="mt-2 text-sm">{{activity.form.name}} · {{#if registrationOpen}}التسجيل مفتوح{{else}}التسجيل مغلق{{/if}}</p>
    </div>
    <div class="grid w-full gap-2 sm:flex sm:w-auto sm:flex-wrap">{{#if canRegister}}<a aria-haspopup="dialog" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-[#287a73] px-4 py-2 font-bold text-white" href="/activities/register/{{activity.id}}" hx-get="/activities/register/{{activity.id}}" hx-target="#modal-root">تسجيل مشارك</a>{{/if}}{{#if canEdit}}<a aria-haspopup="dialog" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border px-4 py-2 font-bold" href="/activities/{{activity.id}}/edit" hx-get="/activities/{{activity.id}}/edit" hx-target="#modal-root">تعديل النشاط</a>{{/if}}
    </div>
  </header>
  {{#if canViewParticipants}}<section class="rounded-2xl border border-slate-200 bg-white p-6"><h2 class="mb-4 font-extrabold">المشاركون ({{activity.participants.length}})</h2>
    <form method="post" action="/activities/{{activity.id}}/attendance">{{> ui/csrf}}{{#if canAttend}}{{#if activity.participants.length}}<p class="mb-3 rounded-xl bg-[#f0faf9] p-3 text-sm">حدّد المشاركين الحاضرين. عند الحفظ يُسجَّل بقية المشاركين غائبين.</p>{{/if}}{{/if}}<ul class="divide-y">{{#each activity.participants}}<li class="py-3">{{#if ../canAttend}}<input type="hidden" name="roster" value="{{id}}"><label class="flex min-h-11 cursor-pointer items-center gap-3 font-semibold"><input class="h-5 w-5 accent-[#287a73]" type="checkbox" name="present" value="{{id}}" {{#if (eq attendanceStatus "PRESENT")}}checked{{/if}}> {{#if guest}}{{guest.fullName}} <small class="text-slate-500">ضيف</small>{{else}}{{student.fullName}}{{/if}}</label>{{else}}<div class="flex flex-wrap items-center justify-between gap-2"><span class="font-semibold">{{#if guest}}{{guest.fullName}} <small class="text-slate-500">ضيف</small>{{else}}{{student.fullName}}{{/if}}</span><span class="rounded-full bg-slate-50 px-3 py-1 text-xs">{{#if (eq attendanceStatus "PRESENT")}}حاضر{{else if (eq attendanceStatus "ABSENT")}}غائب{{else}}لم يُسجّل الحضور{{/if}}</span></div>{{/if}}</li>{{else}}<li class="text-slate-600">لا يوجد مشاركون مسجّلون في هذا النشاط بعد.</li>{{/each}}</ul>{{#if canAttend}}{{#if activity.participants.length}}{{> ui/submit label="حفظ الحضور"}}{{/if}}{{/if}}</form>
  </section>{{/if}}
</section>
