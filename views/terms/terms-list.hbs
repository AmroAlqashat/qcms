<section id="terms-page" aria-labelledby="terms-title">
  <header class="mb-7 flex flex-wrap items-start justify-between gap-4">
    <div>
      <p class="mb-2 text-xs font-bold text-[#287a73]">التعليم</p>
      <h1 id="terms-title" class="text-2xl font-extrabold sm:text-3xl">الفصول والحلقات</h1>
      <p class="mt-2 text-sm leading-7 text-slate-600">الفصول النشطة وحلقاتها. تبقى الفصول نشطة حتى تتم أرشفتها يدويًا.</p>
    </div>
    {{#if permissions.canCreateTerm}}
      <a href="/terms/create" hx-get="/terms/create" hx-target="#modal-root" hx-swap="innerHTML" aria-haspopup="dialog"
        class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-[#2b827a] px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#216c65] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#287a73]">
        {{> ui/icon name="plus"}}فصل جديد
      </a>
    {{/if}}
  </header>
  <form action="/terms" method="get" hx-get="/terms" hx-target="#terms-results" hx-swap="outerHTML" hx-push-url="true"
    hx-trigger="submit, input changed delay:400ms from:input" hx-sync="this:replace" hx-indicator="#terms-search-loading"
    data-terms-search class="mb-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <label for="term-search" class="mb-3 block text-sm font-bold">البحث بمعرّف الفصل</label>
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
      <div class="relative min-w-0 flex-1">
        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-400" aria-hidden="true">{{> ui/icon name="search" class="h-5 w-5"}}</span>
        <input id="term-search" name="termId" type="search" value="{{filters.termId}}" inputmode="numeric" maxlength="5"
          placeholder="مثال: 2027 أو 20271" aria-describedby="term-search-hint" aria-controls="terms-results"
          class="min-h-12 w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-4 pr-11 text-sm text-[#12383b] outline-none focus:border-[#287a73] focus:ring-2 focus:ring-[#a8dfdc]">
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <button type="submit" class="min-h-12 flex-1 rounded-xl bg-[#2b827a] px-6 text-sm font-bold text-white hover:bg-[#216c65] sm:flex-none">بحث</button>
        <button type="button" data-clear-term-search class="min-h-12 rounded-xl border border-slate-200 px-4 text-sm font-bold text-slate-600 hover:bg-slate-50">مسح البحث</button>
      </div>
    </div>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2 text-xs leading-6 text-slate-500">
      <p id="term-search-hint">ابحث بالسنة أو بمعرّف الفصل. تُقبل الأرقام العربية والإنجليزية.</p>
      <span id="terms-search-loading" class="htmx-indicator font-bold text-[#287a73]" role="status">جارٍ البحث…</span>
    </div>
  </form>
  {{> terms/term-results}}
</section>
