<section aria-labelledby="term-title" class="space-y-6">
  <header>
    <a href="/terms" class="mb-4 inline-flex min-h-11 items-center gap-2 rounded-lg text-sm font-semibold text-slate-500 hover:text-[#287a73] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#287a73]">{{> ui/icon name="arrow" class="h-4 w-4"}}جميع الفصول</a>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div class="flex min-w-0 items-center gap-4">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-[#a8dfdc] bg-[#f0faf9] text-[#287a73]" aria-hidden="true">{{> ui/icon name="calendar" class="h-7 w-7"}}</span>
        <div class="min-w-0"><div class="flex flex-wrap items-center gap-3"><h1 id="term-title" class="text-2xl font-extrabold sm:text-3xl">الفصل <bdi>{{term.termId}}</bdi></h1><span class="inline-flex items-center gap-2 rounded-full bg-[#e3f2ef] px-3 py-1 text-xs font-bold text-[#216c65]"><span class="h-1.5 w-1.5 rounded-full bg-[#287a73]" aria-hidden="true"></span>نشط</span></div><p class="mt-2 text-sm text-slate-500">{{term.typeLabel}} · إدارة الحلقات المرتبطة بالفصل</p></div>
      </div>
    </div>
  </header>

  <dl class="grid gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <dt class="mb-3 flex items-center gap-2 text-xs font-semibold text-slate-500">{{> ui/icon name="calendar" class="h-4 w-4"}}تاريخ البداية</dt>
      <dd class="text-base font-bold">{{#if term.isContinuous}}غير محدد{{else}}{{term.startDateLabel}}{{/if}}</dd>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <dt class="mb-3 flex items-center gap-2 text-xs font-semibold text-slate-500">{{> ui/icon name="calendar" class="h-4 w-4"}}تاريخ النهاية</dt>
      <dd class="text-base font-bold">{{#if term.isContinuous}}مستمر دون نهاية محددة{{else}}{{term.endDateLabel}}{{/if}}</dd>
    </div>
    <div class="rounded-2xl border border-[#a8dfdc] bg-[#f0faf9] p-5">
      <dt class="mb-3 flex items-center gap-2 text-xs font-semibold text-[#287a73]">{{> ui/icon name="users" class="h-4 w-4"}}الحلقات المرتبطة</dt>
      <dd class="flex items-baseline gap-2 text-[#195954]"><span class="text-2xl font-extrabold tabular-nums">{{term._count.halaqas}}</span><span class="text-sm">حلقة</span></dd>
    </div>
  </dl>

  <section aria-labelledby="term-halaqas-title" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <header class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-100 p-5 sm:p-6">
      <div><h2 id="term-halaqas-title" class="text-lg font-extrabold">حلقات الفصل</h2><p class="mt-1 text-xs leading-6 text-slate-500">الطلاب المسجّلون والموظفون المعيّنون حاليًا في كل حلقة.</p></div>
      {{#if permissions.canCreateHalaqa}}
        <a href="/halaqas/new?termId={{term.termId}}" hx-get="/halaqas/new?termId={{term.termId}}" hx-target="#modal-root" hx-swap="innerHTML" aria-haspopup="dialog"
          class="inline-flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-[#2b827a] px-5 py-3 text-sm font-bold text-white shadow-sm hover:bg-[#216c65] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#287a73] sm:w-auto">
          {{> ui/icon name="plus" class="h-4 w-4"}}إنشاء حلقة
        </a>
      {{/if}}
    </header>
    {{#if permissions.canViewHalaqas}}
      {{#if term.halaqas.length}}
        <div class="hidden sm:block">
          <table class="w-full text-right text-sm">
            <caption class="sr-only">حلقات الفصل {{term.termId}} وأعداد التسجيلات والتعيينات الحالية</caption>
            <thead class="bg-slate-50 text-xs text-slate-500"><tr><th scope="col" class="px-6 py-4 font-semibold">اسم الحلقة</th><th scope="col" class="px-6 py-4 text-center font-semibold">الطلاب المسجّلون</th><th scope="col" class="px-6 py-4 text-center font-semibold">الموظفون المعيّنون</th></tr></thead>
            <tbody class="divide-y divide-slate-100">
              {{#each term.halaqas}}
                <tr class="hover:bg-slate-50">
                  <th scope="row" class="px-6 py-5"><div class="flex items-center gap-3"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#f0faf9] text-[#287a73]" aria-hidden="true">{{> ui/icon name="users" class="h-5 w-5"}}</span><span class="break-words font-bold">{{name}}</span></div></th>
                  <td class="px-6 py-5 text-center font-bold tabular-nums">{{_count.enrollments}}</td>
                  <td class="px-6 py-5 text-center font-bold tabular-nums">{{_count.staffAssignments}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
        <ul class="divide-y divide-slate-100 sm:hidden">
          {{#each term.halaqas}}
            <li class="p-5"><h3 class="mb-4 flex items-center gap-2 break-words font-bold">{{> ui/icon name="users" class="h-5 w-5 text-[#287a73]"}}{{name}}</h3><dl class="grid grid-cols-2 gap-3"><div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs text-slate-500">الطلاب المسجّلون</dt><dd class="mt-1 text-lg font-bold tabular-nums">{{_count.enrollments}}</dd></div><div class="rounded-xl bg-slate-50 p-3"><dt class="text-xs text-slate-500">الموظفون المعيّنون</dt><dd class="mt-1 text-lg font-bold tabular-nums">{{_count.staffAssignments}}</dd></div></dl></li>
          {{/each}}
        </ul>
      {{else}}
        <div class="px-6 py-12 text-center sm:py-16"><span class="mx-auto mb-5 flex h-16 w-16 items-center justify-center rounded-2xl bg-[#f0faf9] text-[#287a73]" aria-hidden="true">{{> ui/icon name="users" class="h-7 w-7"}}</span><h3 class="text-lg font-bold">ابدأ بحلقات هذا الفصل</h3><p class="mx-auto mt-2 max-w-sm text-sm leading-7 text-slate-500">{{#if permissions.canCreateHalaqa}}لا توجد حلقات بعد. استخدم «إنشاء حلقة» لإضافة أول حلقة لهذا الفصل.{{else}}لا توجد حلقات في هذا الفصل بعد. ستظهر هنا عند إضافتها.{{/if}}</p></div>
      {{/if}}
    {{else}}
      <div class="px-6 py-12 text-center"><span class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-50 text-slate-400" aria-hidden="true">{{> ui/icon name="check-shield"}}</span><h3 class="font-bold">تفاصيل الحلقات غير متاحة</h3><p class="mt-2 text-sm leading-7 text-slate-500">ليس لديك صلاحية عرض حلقات هذا الفصل.</p></div>
    {{/if}}
  </section>
  <p class="flex items-start gap-2 px-1 text-xs leading-6 text-slate-500">{{> ui/icon name="archive" class="mt-1 h-4 w-4"}}يبقى الفصل نشطًا حتى تتم أرشفته يدويًا. انتهاء التاريخ لا يؤرشف الفصل تلقائيًا.</p>
</section>
