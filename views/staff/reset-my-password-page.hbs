{{#> auth/card}}
  {{> auth/heading
    heading="تغيير كلمة المرور"
    description="أرسل رمز تحقق إلى بريدك الإلكتروني المسجّل، ثم أدخله لاختيار كلمة مرور جديدة."
  }}
  <form class='space-y-5' action='/staff/reset-my-password' method='post'>
    {{> ui/csrf}}
    <div>
      <label class='sr-only' for='verification-code'>رمز التحقق المكوّن من ستة أرقام</label>
      <input
        id='verification-code'
        class='otp-input block min-h-14 w-full rounded-xl border border-[#a8dfdc] bg-[#f0faf9] px-3 py-3 text-2xl font-extrabold'
        name='otp'
        type='text'
        inputmode='numeric'
        autocomplete='one-time-code'
        pattern='[0-9]{6}'
        maxlength='6'
        minlength='6'
        required
        dir='ltr'
        aria-describedby='code-hint'
      />
      <p id='code-hint' class='mt-1 text-center text-xs text-slate-600'>
        أدخل الأرقام الستة بالترتيب من اليسار إلى اليمين.
      </p>
    </div>
    {{> ui/field
      id="new-password"
      name="newPassword"
      label="كلمة المرور الجديدة"
      type="password"
      password=true
      required=true
      autocomplete="new-password"
      dir="ltr"
      minlength="8"
      maxlength="128"
      hint="8 أحرف على الأقل، وبحد أقصى 128 حرفًا."
    }}
    {{> ui/submit
      label="تغيير كلمة المرور"
      full=true
    }}
  </form>
  {{> ui/send-otp
    action="/staff/reset-my-password/send-otp"
    prompt="أرسل رمز التحقق إلى بريدك الإلكتروني."
    label="إرسال رمز التحقق"
  }}
{{/auth/card}}
