{{#> auth/card}}
  {{> auth/heading
    heading="تغيير كلمة المرور"
    description="أرسل رمز تحقق إلى بريدك الإلكتروني المسجّل، ثم أدخله لاختيار كلمة مرور جديدة."
  }}
  <form class='space-y-5' action='/staff/reset-my-password' method='post'>
    {{> ui/csrf}}
    <div>
      <label class='sr-only' for='verification-code'>رمز التحقق المكوّن من ستة أرقام</label>
      <input
        id='verification-code'
        class='otp-input block min-h-14 w-full rounded-xl border border-[#a8dfdc] bg-[#f0faf9] px-3 py-3 text-2xl font-extrabold'
        name='otp'
        type='text'
        inputmode='numeric'
        autocomplete='one-time-code'
        pattern='[0-9]{6}'
        maxlength='6'
        minlength='6'
        required
        dir='ltr'
        aria-describedby='code-hint'
      />
      <p id='code-hint' class='mt-1 text-center text-xs text-slate-600'>
        أدخل الأرقام الستة بالترتيب من اليسار إلى اليمين.
      </p>
    </div>
    {{> ui/field
      id="new-password"
      name="newPassword"
      label="كلمة المرور الجديدة"
      type="password"
      password=true
      required=true
      autocomplete="new-password"
      dir="ltr"
      minlength="12"
      maxlength="128"
      hint="12 حرفًا على الأقل، وبحد أقصى 128 حرفًا."
    }}
    {{> ui/submit
      label="تغيير كلمة المرور"
      full=true
    }}
  </form>
  <form action='/staff/reset-my-password/send-otp' method='post'
        hx-post='/staff/reset-my-password/send-otp' hx-swap='none'
        hx-sync='this:drop' data-otp-send
        class='mt-6 border-t border-slate-200 pt-5 text-center'>
    {{> ui/csrf}}
    <p class='mb-3 text-sm text-slate-600'>أرسل رمز التحقق إلى بريدك الإلكتروني.</p>
    <button type='submit' data-otp-send-button aria-describedby='otp-send-status otp-send-countdown'
            class='min-h-11 w-full rounded-xl border border-[#2b827a] bg-[#f0faf9] px-4 py-3 text-sm font-bold text-[#195954] enabled:hover:bg-[#dcefeb] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#287a73] disabled:cursor-not-allowed disabled:border-slate-300 disabled:bg-slate-100 disabled:text-slate-500'>
      إرسال رمز التحقق
    </button>
    <p id='otp-send-countdown' data-otp-send-countdown role='timer' aria-live='off'
       class='mt-2 text-xs leading-6 text-slate-600' hidden></p>
    <p id='otp-send-status' data-otp-send-status role='status' aria-live='polite' aria-atomic='true'
       class='mt-2 text-sm leading-6 text-[#195954]'></p>
  </form>
{{/auth/card}}
