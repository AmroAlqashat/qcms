{{#> auth/card}}
  {{> auth/heading heading="نسيت كلمة المرور؟" description="أدخل بريدك الإلكتروني المسجّل. سنفتح نافذة التحقق لإعادة تعيين كلمة المرور."}}
  <form action='/staff/forgot-my-password/send-otp' method='post' hx-post='/staff/forgot-my-password/send-otp'
    hx-target='#modal-root' hx-swap='innerHTML' hx-disabled-elt='find button[type="submit"]' class='space-y-5'>
    {{> ui/csrf}}
    {{#unless resetStep}}{{> ui/form-error error=error}}{{/unless}}
    {{> ui/field id="forgot-password-email" name="email" label="البريد الإلكتروني" type="email" required=true autocomplete="email" dir="ltr" maxlength="254" value=form.email error=errors.email}}
    {{> ui/submit label="متابعة وإرسال رمز التحقق" full=true}}
  </form>
  {{#if resetStep}}<button type='button' data-dialog-open='{{dialogId}}' class='mt-4 min-h-11 w-full text-sm font-bold text-[#287a73] underline'>إعادة فتح نافذة التحقق</button>{{/if}}
  <p class='mt-5 text-center text-sm'><a class='font-semibold text-[#195954] underline' href='/auth/signIn'>العودة إلى تسجيل الدخول</a></p>
{{/auth/card}}
{{#if resetStep}}{{> ui/otp-dialog}}{{/if}}
