{{#> auth/card}}
  {{#if resetStep}}
    {{> auth/heading
      heading="إعادة تعيين كلمة المرور"
      description="أدخل رمز التحقق الذي أُرسل إلى بريدك الإلكتروني واختر كلمة مرور جديدة."
    }}
    <p class='mb-5 rounded-lg border border-[#a8dfdc] bg-[#f0faf9] px-3 py-2 text-sm text-[#195954]' role='status'>
      {{notice}}
    </p>
    <form class='space-y-5' action='/staff/reset-my-password' method='post'>
      {{> ui/csrf}}
      <input type='hidden' name='email' value='{{email}}'>
      <p class='text-sm text-slate-600' dir='ltr'>{{email}}:رمز التحقق أرسل إلى</p>
      <div>
        <label class='sr-only' for='forgot-password-otp'>رمز التحقق المكوّن من ستة أرقام</label>
        <input
          id='forgot-password-otp'
          class='otp-input block min-h-14 w-full rounded-xl border border-[#a8dfdc] bg-[#f0faf9] px-3 py-3 text-center text-2xl font-extrabold'
          name='otp'
          type='text'
          inputmode='numeric'
          autocomplete='one-time-code'
          pattern='[0-9]{6}'
          maxlength='6'
          minlength='6'
          required
          dir='ltr'
        />
      </div>
      {{> ui/field
        id="forgot-new-password"
        name="newPassword"
        label="كلمة المرور الجديدة"
        type="password"
        required=true
        autocomplete="new-password"
        dir="ltr"
        minlength="8"
        maxlength="128"
        hint="8 أحرف على الأقل، وبحد أقصى 128 حرفًا."
      }}
      {{> ui/submit
        label="إعادة تعيين كلمة المرور"
        full=true
      }}
    </form>
    <form action='/staff/forgot-my-password/send-otp' method='post'
          hx-post='/staff/forgot-my-password/send-otp' hx-swap='none'
          hx-sync='this:drop' data-otp-send data-otp-already-sent
          class='mt-6 border-t border-slate-200 pt-5 text-center'>
      {{> ui/csrf}}
      <input type='hidden' name='email' value='{{email}}'>
      <p class='mb-3 text-sm text-slate-600'>لم يصلك رمز التحقق؟</p>
      <button type='submit' data-otp-send-button aria-describedby='otp-send-status otp-send-countdown'
              class='min-h-11 w-full rounded-xl border border-[#2b827a] bg-[#f0faf9] px-4 py-3 text-sm font-bold text-[#195954] enabled:hover:bg-[#dcefeb] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#287a73] disabled:cursor-not-allowed disabled:border-slate-300 disabled:bg-slate-100 disabled:text-slate-500'>
        إعادة إرسال رمز التحقق
      </button>
      <p id='otp-send-countdown' data-otp-send-countdown role='timer' aria-live='off'
         class='mt-2 text-xs leading-6 text-slate-600' hidden></p>
      <p id='otp-send-status' data-otp-send-status role='status' aria-live='polite' aria-atomic='true'
         class='mt-2 text-sm leading-6 text-[#195954]'></p>
    </form>
    <p class='mt-5 text-center text-sm'>
      <a class='font-semibold text-[#195954] underline-offset-4 hover:underline' href='/staff/forgot-my-password'>إدخال بريد إلكتروني آخر</a>
    </p>
  {{else}}
    {{> auth/heading
      heading="نسيت كلمة المرور؟"
      description="أدخل بريدك الإلكتروني المسجّل لإرسال رمز تحقق وإعادة تعيين كلمة المرور."
    }}
    <form class='space-y-5' action='/staff/forgot-my-password/send-otp' method='post'>
      {{> ui/csrf}}
      {{> ui/field
        id="forgot-password-email"
        name="email"
        label="البريد الإلكتروني"
        type="email"
        required=true
        autocomplete="email"
        dir="ltr"
        maxlength="254"
      }}
      {{> ui/submit
        label="إرسال رمز التحقق"
        full=true
      }}
    </form>
    <p class='mt-5 text-center text-sm'>
      <a class='font-semibold text-[#195954] underline-offset-4 hover:underline' href='/auth/signIn'>العودة إلى تسجيل الدخول</a>
    </p>
  {{/if}}
{{/auth/card}}
