<!doctype html>
<html lang='ar' dir='rtl'>
  <head>
    {{> shared/head}}
    {{{_sections.styles}}}
  </head>
  {{!-- Public pages (no login): no staff sidebar or navigation. --}}
  <body
    class='flex min-h-screen flex-col bg-[#faf7ef] text-[#12383b] antialiased'
    data-public-layout
    hx-history='false'
  >
    <a class='skip-link' href='#main-content'>تجاوز إلى المحتوى</a>
    {{> shared/icons}}
    <main id='main-content' class='flex-1 px-4 py-8 sm:px-6 sm:py-12' tabindex='-1'>
      {{{ body }}}
    </main>
    <footer class='px-4 pb-5 text-center text-xs leading-6 text-[#536e73]'>
      <p>
        ©
        {{#if year}}
          {{ year }}
        {{else}}
          2026
        {{/if}}
        QCMS · نظام إدارة مركز القرآن الكريم
      </p>
    </footer>
    <div id="modal-root"></div>
    <div id="toast-root" class="fixed inset-x-4 top-4 z-[100] flex flex-col items-start gap-3 sm:left-auto sm:right-6 sm:w-[min(24rem,calc(100vw-3rem))]"></div>
    <p id='app-announcement' class='sr-only' role='status' aria-live='polite'></p>
    {{> shared/scripts}}
    {{{_sections.scripts}}}
  </body>
</html>
