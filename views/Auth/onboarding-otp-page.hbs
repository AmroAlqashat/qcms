{{#> auth/card}}
  {{> auth/heading
    heading="تأكيد البريد الإلكتروني"
    description="أدخل رمز التحقق المكوّن من 6 أرقام. الرمز صالح لمدة عشر دقائق."
  }}
  {{> auth/steps-activation-code}}
  {{#if email}}
    <p class='mb-5 break-anywhere text-center text-sm font-bold' dir='ltr'>
      {{ email }}
    </p>
  {{/if}}
  <form class='space-y-5' action='/auth/onboarding/verify-otp' method='post'>
    {{> ui/csrf}}
    {{> ui/form-error
      error=error
    }}
    <label class='sr-only' for='verification-code'>رمز التحقق المكون من ستة أرقام</label>
    {{!-- One accessible input supports whole-code paste and mobile OTP autofill. --}}
    <input
      id='verification-code'
      class='otp-input block min-h-14 w-full rounded-xl border border-[#a8dfdc] bg-[#f0faf9] px-3 py-3 text-2xl font-extrabold'
      name='code'
      type='text'
      inputmode='numeric'
      autocomplete='one-time-code'
      pattern='[0-9]{6}'
      maxlength='6'
      minlength='6'
      required
      dir='ltr'
      aria-describedby='code-hint'
      {{#if error}}
        aria-invalid="true"
      {{/if}}
    />
    <p id='code-hint' class='text-center text-xs text-slate-600'>
      أدخل الأرقام الستة بالترتيب من اليسار إلى اليمين.
    </p>
    {{> ui/submit
      label="تأكيد الرمز"
      full=true
    }}
  </form>
  {{#if notice}}
    <p class='mt-3 text-center text-sm text-[#287a73]' role='status'>
      {{ notice }}
    </p>
  {{/if}}
{{/auth/card}}
