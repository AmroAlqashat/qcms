{{#> auth/card}}
  {{> auth/heading
    heading="أنشئ كلمة مرورك"
    description="تحلّ محل كلمة المرور المؤقتة"
  }}
  {{> auth/steps-password}}
  <form class='space-y-5' action='/auth/onboarding/change-password' method='post' data-password-confirmation>
    {{> ui/csrf}}
    {{> ui/form-error
      error=error
    }}
    {{> ui/field
      id="new-password"
      name="newPassword"
      label="كلمة المرور الجديدة"
      type="password"
      password=true
      required=true
      autocomplete="new-password"
      dir="ltr"
      minlength="12"
      maxlength="128"
      error=errors.newPassword
    }}
    {{> ui/field
      id="confirm-password"
      name="confirmPassword"
      label="تأكيد كلمة المرور"
      type="password"
      password=true
      required=true
      autocomplete="new-password"
      dir="ltr"
      minlength="12"
      maxlength="128"
      error=errors.confirmPassword
    }}
    {{!-- Keep the existing app.js password-confirmation handler target. --}}
    <p id='password-mismatch-error' class='mt-1 text-xs text-red-700' role='alert' hidden>
      كلمتا المرور غير متطابقتين.
    </p>
    {{> auth/password-guidance}}
    {{> ui/alert
      message="تتوقف كلمة المرور المؤقتة فور حفظ كلمة مرورك الجديدة. لا يعرف المدير كلمة مرورك الجديدة."
    }}
    {{> ui/submit
      label="حفظ ومتابعة"
      full=true
    }}
  </form>
{{/auth/card}}
