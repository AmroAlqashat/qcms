<!DOCTYPE html>
<html lang='ar' dir='rtl'>
  <head>
    {{> shared/head}}
  </head>
  <body class='min-h-screen bg-[#f5f6f8] text-[#12383b] antialiased'>
    {{> shared/icons}}
    <main class='flex min-h-screen items-center justify-center px-4 py-10'>
      <section class='w-full max-w-md rounded-3xl bg-white p-6 shadow-xl shadow-[#12383b]/10 sm:p-10'>
        <p class='mb-2 text-sm font-semibold text-[#287a73]'>إعداد الحساب</p>
        <h1 class='text-2xl font-extrabold'>غيّر كلمة المرور</h1>
        <p class='mt-2 text-sm leading-7 text-slate-600'>اختر كلمة مرور جديدة لا تقل عن 12 حرفاً.</p>
        <form
          class='mt-6 space-y-5'
          action='/auth/onboarding/change-password'
          method='post'
          data-password-confirmation
        >
          {{> ui/csrf}}
          <div>
            <label class='mb-2 block text-sm font-semibold' for='new-password'>كلمة المرور الجديدة</label>
            <input
              id='new-password'
              class='block min-h-11 w-full rounded-lg border border-[#a8dfdc] bg-[#f0faf9] px-3 py-2.5 text-left text-sm text-[#12383b]'
              name='newPassword'
              type='password'
              autocomplete='new-password'
              minlength='12'
              maxlength='128'
              required
            />
            <p id='password-mismatch-error' class='mt-1 text-xs text-red-700' role='alert' hidden>
              كلمتا المرور غير متطابقتين.
            </p>
          </div>
          <div>
            <label class='mb-2 block text-sm font-semibold' for='confirm-password'>تأكيد كلمة المرور</label>
            <input
              id='confirm-password'
              class='block min-h-11 w-full rounded-lg border border-[#a8dfdc] bg-[#f0faf9] px-3 py-2.5 text-left text-sm text-[#12383b]'
              name='confirmPassword'
              type='password'
              autocomplete='new-password'
              minlength='12'
              maxlength='128'
              required
              aria-describedby='password-mismatch-error'
            />
          </div>
          <button
            class='inline-flex min-h-11 w-full items-center justify-center rounded-xl bg-[#2b827a] px-5 py-3 text-sm font-bold text-white hover:bg-[#216c65]'
            type='submit'
          >
            حفظ كلمة المرور
          </button>
        </form>
      </section>
    </main>
    {{> shared/scripts}}
  </body>
</html>
