{
  "singleQuote": true,
  "trailingComma": "all",
  "plugins": [
    "@poliklot/prettier-plugin-handlebars"
  ],
  "overrides": [
    {
      "files": "*.hbs",
      "options": {
        "parser": "handlebars",
        "printWidth": 110,
        "tabWidth": 2,
        "classAttributeLayout": "single-line"
      }
    }
  ]
}
