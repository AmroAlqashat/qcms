{
  "name": "qcms",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run css:build && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "concurrently -k -n nest,css -c blue,magenta \"nest start --watch\" \"npm run css:dev\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "css:dev": "tailwindcss -i ./assets/styles/tailwind.css -o ./public/css/source.css --watch",
    "css:build": "tailwindcss -i ./assets/styles/tailwind.css -o ./public/css/source.css --minify",
    "postinstall": "prisma skills sync || exit 0",
    "superadmin:recover": "ts-node --files scripts/recover-superadmin.ts",
    "seed:permissions": "tsx prisma/seed-permissions.ts",
    "seed:settings": "tsx prisma/seed-settings.ts",
    "setup:token": "tsx scripts/setup-token.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^4.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "connect-pg-simple": "^10.0.0",
    "express-handlebars": "^8.0.3",
    "express-session": "^1.19.0",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@poliklot/prettier-plugin-handlebars": "^0.4.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
