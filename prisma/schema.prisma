generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activities {
  id                       String                     @id
  name                     String
  level                    ActivityLevel
  halaqaId                 String?
  date                     DateTime
  Halaqas                  Halaqas?                   @relation(fields: [halaqaId], references: [id])
  ActivityParticipants     ActivityParticipants[]
  StaffActivityAssignments StaffActivityAssignments[]
}

model ActivityParticipants {
  studentId  String
  activityId String
  attendedAt DateTime?
  Activities Activities @relation(fields: [activityId], references: [id])
  Students   Students   @relation(fields: [studentId], references: [id])

  @@id([studentId, activityId])
}

model AuditEvents {
  id           String        @id
  actorId      String?
  targetId     String
  createdAt    DateTime      @default(now())
  isSuccess    Boolean
  roleName     String?
  actionType   AuditAction
  targetType   AuditTarget
  StaffMembers StaffMembers? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([targetType, targetId])
}

model DirectPermissionGrants {
  id           String       @id
  staffId      String
  permissionId String
  scopeType    ScopeType
  grantedById  String
  grantedAt    DateTime     @default(now())
  revokedAt    DateTime?
  Permissions  Permissions  @relation(fields: [permissionId], references: [id])
  StaffMembers StaffMembers @relation(fields: [staffId], references: [id])

  @@unique([staffId, permissionId, scopeType])
}

model Enrollments {
  id         String    @id
  studentId  String
  halaqaId   String
  enrolledAt DateTime  @default(now())
  endedAt    DateTime?
  Halaqas    Halaqas   @relation(fields: [halaqaId], references: [id])
  Students   Students  @relation(fields: [studentId], references: [id])
}

model GuardianStudentLinks {
  id          String    @id
  guardianId  String
  studentId   String
  createdById String
  removedAt   DateTime?
  removedById String?
  Guardians   Guardians @relation(fields: [guardianId], references: [id])
  Students    Students  @relation(fields: [studentId], references: [id])
}

model Guardians {
  id                   String                 @id
  fullName             String
  primaryPhone         String
  secondaryPhone       String?
  createdAt            DateTime               @default(now())
  GuardianStudentLinks GuardianStudentLinks[]
}

model HalaqaTransfers {
  id                                            String   @id
  studentId                                     String
  fromHalaqaId                                  String
  toHalaqaId                                    String
  actingStaffId                                 String
  transferredAt                                 DateTime @default(now())
  Halaqas_HalaqaTransfers_fromHalaqaIdToHalaqas Halaqas  @relation("HalaqaTransfers_fromHalaqaIdToHalaqas", fields: [fromHalaqaId], references: [id])
  Students                                      Students @relation(fields: [studentId], references: [id])
  Halaqas_HalaqaTransfers_toHalaqaIdToHalaqas   Halaqas  @relation("HalaqaTransfers_toHalaqaIdToHalaqas", fields: [toHalaqaId], references: [id])
}

model Halaqas {
  id                                                    String                  @id
  termId                                                String
  name                                                  String
  meetingDays                                           Json
  Activities                                            Activities[]
  Enrollments                                           Enrollments[]
  HalaqaTransfers_HalaqaTransfers_fromHalaqaIdToHalaqas HalaqaTransfers[]       @relation("HalaqaTransfers_fromHalaqaIdToHalaqas")
  HalaqaTransfers_HalaqaTransfers_toHalaqaIdToHalaqas   HalaqaTransfers[]       @relation("HalaqaTransfers_toHalaqaIdToHalaqas")
  Terms                                                 Terms                   @relation(fields: [termId], references: [id])
  StaffClassAssignments                                 StaffClassAssignments[]
}

model OTPs {
  id           String       @id
  staffId      String
  codeHash     String       @db.VarChar(64)
  expiresAt    DateTime
  sentAt       DateTime     @default(now())
  attempts     Int          @default(0)
  purpose      OtpPurpose
  targetEmail  String?
  StaffMembers StaffMembers @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, purpose])
}

model Permissions {
  id                     String                   @id
  category               String
  allowedScopes          ScopeType[]
  resource               Int
  action                 Int
  DirectPermissionGrants DirectPermissionGrants[]
  permission_actions     permission_actions       @relation(fields: [action], references: [id], onDelete: Cascade, map: "action_permission_frk")
  permission_resources   permission_resources     @relation(fields: [resource], references: [id], onDelete: Cascade, map: "resource_permission_frk")
  RolePermissions        RolePermissions[]

  @@unique([resource, action], map: "resource_action_unique_key")
  @@index([id])
}

model RolePermissions {
  id           String      @id
  roleId       String
  permissionId String
  scopeType    ScopeType
  Permissions  Permissions @relation(fields: [permissionId], references: [id])
  Roles        Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, scopeType])
  @@index([id])
}

model RoleStaffAssignments {
  id           String       @id
  staffId      String
  grantedById  String
  grantedAt    DateTime     @default(now())
  revokedAt    DateTime?
  roleId       String
  Roles        Roles        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  StaffMembers StaffMembers @relation(fields: [staffId], references: [id])

  @@unique([staffId, roleId])
}

model Roles {
  id                   String                 @id
  name                 String                 @unique
  description          String?
  createdAt            DateTime               @default(now())
  isSuperAdminRole     Boolean                @default(false)
  RolePermissions      RolePermissions[]
  RoleStaffAssignments RoleStaffAssignments[]

  @@index([id])
}

model Settings {
  id      String   @id
  key     String
  value   Json
  setById String
  setAt   DateTime @default(now())

  @@index([key, setAt])
}

model SpecialCaseNotes {
  id        String   @id
  studentId String
  note      String
  authorId  String
  createdAt DateTime @default(now())
  Students  Students @relation(fields: [studentId], references: [id])
}

model StaffActivityAssignments {
  id           String       @id
  assignedAt   DateTime?    @default(now())
  endedAt      DateTime?
  staffId      String
  activityId   String
  Activities   Activities   @relation(fields: [activityId], references: [id])
  StaffMembers StaffMembers @relation(fields: [staffId], references: [id])

  @@index([staffId, endedAt])
}

model StaffClassAssignments {
  id           String       @id
  assignedAt   DateTime?    @default(now())
  endedAt      DateTime?
  staffId      String
  halaqaId     String
  Halaqas      Halaqas      @relation(fields: [halaqaId], references: [id])
  StaffMembers StaffMembers @relation(fields: [staffId], references: [id])

  @@index([staffId, endedAt])
}

model StaffMembers {
  id                       String                     @id
  email                    String                     @unique
  passwordHash             String?
  fullName                 String?
  status                   StaffStatus                @default(INACTIVE)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  dateOfBirth              DateTime?                  @db.Date
  mustChangePassword       Boolean
  nationalId               String?                    @db.VarChar(30)
  phone                    String?                    @db.VarChar(20)
  isDeleted                Boolean                    @default(false)
  isSuperAdmin             Boolean                    @default(false)
  jobTitle                 JobTitle?
  sessionVersion           Int                        @default(0)
  AuditEvents              AuditEvents[]
  DirectPermissionGrants   DirectPermissionGrants[]
  OTPs                     OTPs[]
  RoleStaffAssignments     RoleStaffAssignments[]
  StaffActivityAssignments StaffActivityAssignments[]
  StaffClassAssignments    StaffClassAssignments[]

  @@index([id])
}

model Students {
  id                   String                 @id
  fullName             String
  dateOfBirth          DateTime
  nationalId           String                 @unique
  createdAt            DateTime               @default(now())
  ActivityParticipants ActivityParticipants[]
  Enrollments          Enrollments[]
  GuardianStudentLinks GuardianStudentLinks[]
  HalaqaTransfers      HalaqaTransfers[]
  SpecialCaseNotes     SpecialCaseNotes[]
  TermRegistrations    TermRegistrations[]
}

model SystemSetups {
  id             Int       @id @default(1)
  tokenHash      String?
  tokenExpiresAt DateTime?
  failedAttempts Int       @default(0)
  completedAt    DateTime?
}

model TermRegistrations {
  id              String             @id
  studentId       String
  termId          String
  status          RegistrationStatus @default(PENDING)
  submittedAt     DateTime           @default(now())
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason String?
  Students        Students           @relation(fields: [studentId], references: [id])
  Terms           Terms              @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

model Terms {
  id                String              @id
  name              String
  startDate         DateTime
  endDate           DateTime
  archivedAt        DateTime?
  Halaqas           Halaqas[]
  TermRegistrations TermRegistrations[]
}

model permission_actions {
  id          Int           @id @default(autoincrement())
  eng_name    String        @unique(map: "action_eng_name_unique")
  arb_name    String
  Permissions Permissions[]
}

model permission_resources {
  id          Int           @id @default(autoincrement())
  eng_name    String        @unique(map: "resource_eng_name_unique")
  arb_name    String
  Permissions Permissions[]
}

model sessions {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

enum ActivityLevel {
  CENTER_WIDE
  HALAQA_SPECIFIC
}

enum AuditAction {
  STAFF_ONBOARDING_COMPLETED
  STAFF_INVITED
  STAFF_ACTIVATED
  STAFF_DEACTIVATED
  STAFF_DELETED
  STAFF_UPDATED
  STAFF_ROLE_ASSIGNED
  STAFF_ROLE_REMOVED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  SYSTEM_SETUP_COMPLETED
  SUPERADMIN_RECOVERED
}

enum AuditTarget {
  STAFF
  STUDENT
  ROLE
}

enum JobTitle {
  SUPERADMIN
  ADMIN
  TEACHER
  FINANCE
  MISC
}

enum OtpPurpose {
  ONBOARDING
  PASSWORD_CHANGE
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScopeType {
  CENTER_WIDE
  ASSIGNED_CLASS
  OWN_ACCOUNT
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  PENDING
}
