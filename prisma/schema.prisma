generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// QCMS — Sprint 0 schema (Permissions + Staff/Classes + Registration)

// ENUMS

enum StaffStatus {
  ACTIVE
  INACTIVE
}

enum ScopeType {
  CENTRE_WIDE
  ASSIGNED_CLASS
  ASSIGNED_ACTIVITY
  OWN_ACCOUNT
}

enum ActivityLevel {
  CENTRE_WIDE
  HALAQA_SPECIFIC
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

// PERMISSIONS

model Staff {
  id           String      @id @default(uuid())
  email        String      @unique
  passwordHash String
  fullName     String
  jobTitle     String?
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  roleGrants          RoleStaff[]
  classAssignments    StaffClassAssignment[]
  activityAssignments StaffActivityAssignment[]
  auditEvents         AuditEvent[]
}

model Permission {
  id              String           @id @default(uuid())
  resource        String
  action          String
  category        String
  allowedScopes   ScopeType[]
  rolePermissions RolePermission[]

  @@unique([resource, action])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String      @id @default(uuid())
  roleId       String
  role         Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission  @relation(fields: [permissionId], references: [id])
  scopeType    ScopeType
  roleStaff    RoleStaff[]

  @@unique([roleId, permissionId, scopeType])
}

model RoleStaff {
  id               String         @id @default(uuid())
  staffId          String
  staff            Staff          @relation(fields: [staffId], references: [id])
  rolePermissionId String
  rolePermission   RolePermission @relation(fields: [rolePermissionId], references: [id])
  grantedById      String // who granted it — stored as plain id, no relation
  grantedAt        DateTime       @default(now())
  revokedAt        DateTime?

  @@unique([staffId, rolePermissionId])
}

model StaffClassAssignment {
  staffId  String
  staff    Staff  @relation(fields: [staffId], references: [id])
  halaqaId String
  halaqa   Halaqa @relation(fields: [halaqaId], references: [id])

  @@id([staffId, halaqaId])
}

model StaffActivityAssignment {
  staffId    String
  staff      Staff    @relation(fields: [staffId], references: [id])
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id])

  @@id([staffId, activityId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  actorId    String?
  actor      Staff?   @relation(fields: [actorId], references: [id])
  actionType String
  targetType String
  targetId   String
  outcome    String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

