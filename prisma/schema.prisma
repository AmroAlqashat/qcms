// STAFF & CLASSES

model Term {
  id         String    @id @default(uuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  archivedAt DateTime?

  halaqas           Halaqa[]
  termRegistrations TermRegistration[]
}

model Halaqa {
  id          String @id @default(uuid())
  termId      String
  term        Term   @relation(fields: [termId], references: [id])
  name        String
  meetingDays Json

  staffAssignments StaffClassAssignment[]
  enrollments      Enrollment[]
  activities       Activity[]
  transfersFrom    HalaqaTransfer[]       @relation("TransferFrom")
  transfersTo      HalaqaTransfer[]       @relation("TransferTo")
}

model Activity {
  id       String        @id @default(uuid())
  name     String
  level    ActivityLevel
  halaqaId String?
  halaqa   Halaqa?       @relation(fields: [halaqaId], references: [id])
  date     DateTime

  staffAssignments StaffActivityAssignment[]
  participants     ActivityParticipant[]
}

model Enrollment {
  id         String    @id @default(uuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  halaqaId   String
  halaqa     Halaqa    @relation(fields: [halaqaId], references: [id])
  enrolledAt DateTime  @default(now())
  endedAt    DateTime?
}

model HalaqaTransfer {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  fromHalaqaId  String
  fromHalaqa    Halaqa   @relation("TransferFrom", fields: [fromHalaqaId], references: [id])
  toHalaqaId    String
  toHalaqa      Halaqa   @relation("TransferTo", fields: [toHalaqaId], references: [id])
  actingStaffId String // who performed the transfer — plain id, no relation
  transferredAt DateTime @default(now())
}

model ActivityParticipant {
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id])
  activityId String
  activity   Activity  @relation(fields: [activityId], references: [id])
  attendedAt DateTime?

  @@id([studentId, activityId])
}

// REGISTRATION & GUARDIANS

model Student {
  id          String   @id @default(uuid())
  fullName    String
  dateOfBirth DateTime
  nationalId  String   @unique
  createdAt   DateTime @default(now())

  guardianLinks     GuardianStudentLink[]
  enrollments       Enrollment[]
  transfers         HalaqaTransfer[]
  activityEntries   ActivityParticipant[]
  specialCaseNotes  SpecialCaseNote[]
  termRegistrations TermRegistration[]
}

model Guardian {
  id             String   @id @default(uuid())
  fullName       String
  primaryPhone   String
  secondaryPhone String?
  createdAt      DateTime @default(now())

  studentLinks GuardianStudentLink[]
}

model GuardianStudentLink {
  id          String    @id @default(uuid())
  guardianId  String
  guardian    Guardian  @relation(fields: [guardianId], references: [id])
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id])
  createdById String
  removedAt   DateTime?
  removedById String?
}

model TermRegistration {
  id              String             @id @default(uuid())
  studentId       String
  student         Student            @relation(fields: [studentId], references: [id])
  termId          String
  term            Term               @relation(fields: [termId], references: [id])
  status          RegistrationStatus @default(PENDING)
  submittedAt     DateTime           @default(now())
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason String?

  @@unique([studentId, termId])
}

model SpecialCaseNote {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  note      String
  authorId  String
  createdAt DateTime @default(now())
}

model Setting {
  id      String   @id @default(uuid())
  key     String
  value   Json
  setById String
  setAt   DateTime @default(now())

  @@index([key, setAt])
}
