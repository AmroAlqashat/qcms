generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StaffMembers {
  id                     String                     @id @default(uuid())
  email                  String                     @unique
  passwordHash           String
  fullName               String
  jobTitle               String
  status                 StaffStatus                @default(INACTIVE)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  dateOfBirth            DateTime?                  @db.Date
  mustChangePassword     Boolean
  nationalId             String?                    @db.VarChar(30)
  phone                  String?                    @db.VarChar(20)
  auditEvents            AuditEvents[]
  directPermissionGrants DirectPermissionGrants[]
  OTP                    OTPs?
  roleGrants             RoleStaffAssignments[]
  activityAssignments    StaffActivityAssignments[]
  classAssignments       StaffClassAssignments[]

  @@index([id])
}

model Permissions {
  id                     String                   @id @default(uuid())
  resource               String
  action                 String
  category               String
  allowedScopes          ScopeType[]
  directPermissionGrants DirectPermissionGrants[]
  rolePermissions        RolePermissions[]

  @@unique([resource, action])
  @@index([id])
}

model DirectPermissionGrants {
  id           String       @id @default(uuid())
  staffId      String
  permissionId String
  scopeType    ScopeType
  grantedById  String
  grantedAt    DateTime     @default(now())
  revokedAt    DateTime?
  permission   Permissions  @relation(fields: [permissionId], references: [id])
  staff        StaffMembers @relation(fields: [staffId], references: [id])

  @@unique([staffId, permissionId, scopeType])
}

model Roles {
  id              String                 @id @default(uuid())
  name            String                 @unique
  description     String?
  createdAt       DateTime               @default(now())
  rolePermissions RolePermissions[]
  staffGrants     RoleStaffAssignments[]

  @@index([id])
}

model RolePermissions {
  id           String      @id @default(uuid())
  roleId       String
  permissionId String
  scopeType    ScopeType
  permission   Permissions @relation(fields: [permissionId], references: [id])
  role         Roles       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId, scopeType])
  @@index([id])
}

model RoleStaffAssignments {
  id          String       @id @default(uuid())
  staffId     String
  grantedById String
  grantedAt   DateTime     @default(now())
  revokedAt   DateTime?
  roleId      String
  role        Roles        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  staff       StaffMembers @relation(fields: [staffId], references: [id])

  @@unique([staffId, roleId])
}

model StaffClassAssignments {
  staffId  String
  halaqaId String
  halaqa   Halaqas      @relation(fields: [halaqaId], references: [id])
  staff    StaffMembers @relation(fields: [staffId], references: [id])

  @@id([staffId, halaqaId])
}

model StaffActivityAssignments {
  staffId    String
  activityId String
  activity   Activities   @relation(fields: [activityId], references: [id])
  staff      StaffMembers @relation(fields: [staffId], references: [id])

  @@id([staffId, activityId])
}

model AuditEvents {
  id         String        @id @default(uuid())
  actorId    String?
  targetId   String
  createdAt  DateTime      @default(now())
  isSuccess  Boolean
  roleName   String?
  actionType AuditAction
  targetType AuditTarget
  actor      StaffMembers? @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([actorId])
}

model Terms {
  id                String              @id @default(uuid())
  name              String
  startDate         DateTime
  endDate           DateTime
  archivedAt        DateTime?
  halaqas           Halaqas[]
  termRegistrations TermRegistrations[]
}

model Halaqas {
  id               String                  @id @default(uuid())
  termId           String
  name             String
  meetingDays      Json
  activities       Activities[]
  enrollments      Enrollments[]
  term             Terms                   @relation(fields: [termId], references: [id])
  transfersFrom    HalaqaTransfers[]       @relation("TransferFrom")
  transfersTo      HalaqaTransfers[]       @relation("TransferTo")
  staffAssignments StaffClassAssignments[]
}

model Activities {
  id               String                     @id @default(uuid())
  name             String
  level            ActivityLevel
  halaqaId         String?
  date             DateTime
  halaqa           Halaqas?                   @relation(fields: [halaqaId], references: [id])
  participants     ActivityParticipants[]
  staffAssignments StaffActivityAssignments[]
}

model Enrollments {
  id         String    @id @default(uuid())
  studentId  String
  halaqaId   String
  enrolledAt DateTime  @default(now())
  endedAt    DateTime?
  halaqa     Halaqas   @relation(fields: [halaqaId], references: [id])
  student    Students  @relation(fields: [studentId], references: [id])
}

model HalaqaTransfers {
  id            String   @id @default(uuid())
  studentId     String
  fromHalaqaId  String
  toHalaqaId    String
  actingStaffId String
  transferredAt DateTime @default(now())
  fromHalaqa    Halaqas  @relation("TransferFrom", fields: [fromHalaqaId], references: [id])
  student       Students @relation(fields: [studentId], references: [id])
  toHalaqa      Halaqas  @relation("TransferTo", fields: [toHalaqaId], references: [id])
}

model ActivityParticipants {
  studentId  String
  activityId String
  attendedAt DateTime?
  activity   Activities @relation(fields: [activityId], references: [id])
  student    Students   @relation(fields: [studentId], references: [id])

  @@id([studentId, activityId])
}

model Students {
  id                String                 @id @default(uuid())
  fullName          String
  dateOfBirth       DateTime
  nationalId        String                 @unique
  createdAt         DateTime               @default(now())
  activityEntries   ActivityParticipants[]
  enrollments       Enrollments[]
  guardianLinks     GuardianStudentLinks[]
  transfers         HalaqaTransfers[]
  specialCaseNotes  SpecialCaseNotes[]
  termRegistrations TermRegistrations[]
}

model Guardians {
  id             String                 @id @default(uuid())
  fullName       String
  primaryPhone   String
  secondaryPhone String?
  createdAt      DateTime               @default(now())
  studentLinks   GuardianStudentLinks[]
}

model GuardianStudentLinks {
  id          String    @id @default(uuid())
  guardianId  String
  studentId   String
  createdById String
  removedAt   DateTime?
  removedById String?
  guardian    Guardians @relation(fields: [guardianId], references: [id])
  student     Students  @relation(fields: [studentId], references: [id])
}

model TermRegistrations {
  id              String             @id @default(uuid())
  studentId       String
  termId          String
  status          RegistrationStatus @default(PENDING)
  submittedAt     DateTime           @default(now())
  decidedById     String?
  decidedAt       DateTime?
  rejectionReason String?
  student         Students           @relation(fields: [studentId], references: [id])
  term            Terms              @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

model SpecialCaseNotes {
  id        String   @id @default(uuid())
  studentId String
  note      String
  authorId  String
  createdAt DateTime @default(now())
  student   Students @relation(fields: [studentId], references: [id])
}

model Settings {
  id      String   @id @default(uuid())
  key     String
  value   Json
  setById String
  setAt   DateTime @default(now())

  @@index([key, setAt])
}

model OTPs {
  id        String       @id @default(uuid())
  staffId   String       @unique
  codeHash  String       @db.VarChar(64)
  expiresAt DateTime
  sentAt    DateTime     @default(now())
  attempts  Int          @default(0)
  Staff     StaffMembers @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model sessions {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}

enum StaffStatus {
  ACTIVE
  INACTIVE
  PENDING
  DELETED
}

enum ScopeType {
  CENTER_WIDE
  ASSIGNED_CLASS
  ASSIGNED_ACTIVITY
  OWN_ACCOUNT
}

enum ActivityLevel {
  CENTER_WIDE
  HALAQA_SPECIFIC
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuditAction {
  STAFF_ONBOARDING_COMPLETED
  STAFF_INVITED
  STAFF_ACTIVATED
  STAFF_DEACTIVATED
  STAFF_DELETED
  STAFF_UPDATED
  STAFF_ROLE_ASSIGNED
  STAFF_ROLE_REMOVED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
}

enum AuditTarget {
  STAFF
  STUDENT
  ROLE
}
